[
  { q: "¿Cuál es la temperatura adecuada de cocción para eliminar la mayoría de bacterias peligrosas en los alimentos?", o: ["50°C", "70°C", "40°C"], a: "70°C", r: "Anexo: La correcta cocción mata bacterias peligrosas cuando todas las partes del alimento alcanzan los 70°C." },
  { q: "¿Es seguro dejar alimentos cocidos a temperatura ambiente por más de 2 horas?", o: ["Falso", "Verdadero"], a: "Falso", r: "Anexo: No deje alimentos cocidos a temperatura ambiente por más de 2 horas." },
  { q: "¿A qué temperatura deben mantenerse los alimentos perecederos en refrigeración?", o: ["Por encima de 10°C", "A 15°C", "Por debajo de 5°C"], a: "Por debajo de 5°C", r: "Anexo: Enfríe lo más pronto posible los alimentos perecederos, preferentemente bajo los 5°C." },
  { q: "¿La Salmonella es una bacteria poco resistente al calor?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 6: Las Salmonellas son como casi todas las bacterias, poco resistentes al calor." },
  { q: "¿Cuál es el tiempo recomendado para el lavado de manos con agua y jabón a falta de cepillo?", o: ["Al menos 10 segundos", "Al menos 20 segundos", "Al menos 60 segundos"], a: "Al menos 20 segundos", r: "Página 17: A falta de cepillo, el lavado con agua y jabón se hará al menos por 20 segundos." },
  { q: "¿El botulismo es una enfermedad causada por toxinas de bacterias que se reproducen en ambientes sin aire?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 8: El botulismo es causado por bacterias que se reproducen en medios sin aire." },
  { q: "¿Qué método es seguro para descongelar alimentos?", o: ["A temperatura ambiente", "Bajo el sol", "En el refrigerador"], a: "En el refrigerador", r: "Página 35: La descongelación se tiene que efectuar en el refrigerador hasta cuando la temperatura ascienda a unos 5°C." },
  { q: "¿Es recomendable descongelar alimentos a temperatura ambiente?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 35: La descongelación a temperatura ambiente no es recomendable ya que permite la multiplicación de microorganismos." },
  { q: "¿Cuál es el rango considerado como 'Zona de Peligro' para la reproducción bacteriana?", o: ["Entre 5°C y 60°C", "Entre -18°C y 0°C", "Entre 70°C y 100°C"], a: "Entre 5°C y 60°C", r: "Página 28: Los productos deben ser colocados fuera de la zona de peligro, es decir entre 5 y 60 grados centígrados." },
  { q: "¿La contaminación cruzada ocurre cuando un alimento crudo entra en contacto con uno cocido?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 12: La contaminación cruzada se da cuando el manipulador permite el contacto de un alimento crudo con uno cocido." },
  { q: "¿Qué principio de rotación de materias primas debe aplicarse en el almacenamiento?", o: ["Lo Último que Entra es lo Primero que Sale", "Lo Primero que Entra es lo Primero que Sale", "Consumir sin importar la fecha"], a: "Lo Primero que Entra es lo Primero que Sale", r: "Página 28: La correcta rotación consiste en aplicar el principio 'Lo Primero que Entra, es lo Primero que Sale' (PEPS)." },
  { q: "¿Se pueden almacenar productos químicos junto con los alimentos si están cerrados?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 28: Nunca se deberán almacenar productos químicos o de limpieza en las áreas destinadas a alimentos." },
  { q: "¿A qué temperatura se deben mantener congelados los alimentos?", o: ["0°C", "-18°C", "-5°C"], a: "-18°C", r: "Página 31: En el almacenamiento congelado se mantienen los alimentos a una temperatura de menos 18 grados centígrados." },
  { q: "¿Es seguro volver a congelar un alimento que ya ha sido descongelado previamente sin cocinarlo?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 32: Solamente si el alimento ha sido completamente cocido, podrá procederse a una nueva congelación." },
  { q: "¿Cómo se debe colocar la carne cruda y cocida en la heladera para evitar goteos?", o: ["La carne cruda arriba de la cocida", "Ambas en la misma bandeja", "La carne cruda debajo de los alimentos cocinados"], a: "La carne cruda debajo de los alimentos cocinados", r: "Página 31: Se aconseja colocar la carne cruda debajo de los alimentos cocinados para evitar goteos." },
  { q: "¿Cuál es el principal vehículo de transmisión de microorganismos por parte del manipulador?", o: ["Las manos", "El cabello", "El calzado"], a: "Las manos", r: "Página 16: Las manos constituyen el principal vehículo de transmisión de microorganismos." },
  { q: "¿Es obligatorio el uso de tapabocas en personas que presentan síntomas respiratorios o resfríos al manipular alimentos?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 18: El uso de tapabocas será obligatorio en manipuladores con síntomas respiratorios." },
  { q: "¿Qué tipo de agua debe utilizarse siempre para la preparación de alimentos y lavado de vajilla?", o: ["Agua de pozo no tratada", "Agua potable", "Agua acumulada en recipientes abiertos"], a: "Agua potable", r: "Anexo: Use agua potable o asegúrese de tratarla para que sea segura." },
  { q: "¿Los alimentos envasados al vacío están totalmente libres de riesgo de proliferación bacteriana?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 8: Algunas bacterias anaerobias como Clostridium botulinum pueden proliferar en ausencia de oxígeno." },
  { q: "¿Qué se debe hacer con los productos enlatados que presentan abolladuras, hinchazón ó óxido?", o: ["Desecharlos inmediatamente", "Hervir el contenido y consumir", "Consumirlos rápido"], a: "Desecharlos inmediatamente", r: "Página 27: No deben aceptarse latas abolladas, abombadas o con presencia de óxido." },
  { q: "¿Es permitido el uso de joyas, anillos o relojes durante la manipulación de alimentos?", o: ["Verdadero", "Falso"], a: "Falso", r: "Página 18: No se debe usar anillos, pulseras o relojes durante la manipulación, ya que acumulan suciedad y microorganismos." },
  { q: "¿A qué temperatura mínima debe recalentarse la comida previamente cocinada antes de consumirla?", o: ["50°C", "70°C", "60°C"], a: "70°C", r: "Anexo: Recaliente completamente los alimentos cocinados alcanzando los 70°C en todo el producto." },
  { q: "¿Las tablas de picar de madera son recomendadas en la manipulación profesional de alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 22: La madera no es un material recomendable debido a su porosidad y dificultad para ser desinfectada." },
  { q: "¿Qué se debe hacer si un manipulador de alimentos presenta heridas o cortes en las manos?", o: ["Lavar con agua y continuar sin protección", "Cubrir la herida con una venda impermeable y usar guante", "Ignorar la herida si es pequeña"], a: "Cubrir la herida con una venda impermeable y usar guante", r: "Página 18: Las heridas o cortes deben cubrirse con un vendaje impermeable y se debe colocar un guante protector." },
  { q: "¿Los detergentes eliminan las bacterias y microorganismos por sí solos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 21: Los detergentes remueven la grasa y suciedad, mientras que los desinfectantes son los encargados de reducir las bacterias." },
  { q: "¿Cuál es el orden correcto para el acondicionamiento de las instalaciones de cocina?", o: ["Desinfectar y luego limpiar", "Limpiar y luego desinfectar", "Solo secar al aire"], a: "Limpiar y luego desinfectar", r: "Página 21: Primero se debe realizar la limpieza para retirar restos orgánicos y posteriormente desinfectar." },
  { q: "¿Los alimentos cocinados se pueden mezclar con alimentos crudos en el mismo recipiente?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 12: Evite siempre el contacto directo o indirecto entre alimentos crudos y cocinados." },
  { q: "¿Qué insectos u organismos son considerados plagas de alto riesgo en la industria alimentaria?", o: ["Cucarachas y roedores", "Lombrices de tierra", "Abejas de jardín"], a: "Cucarachas y roedores", r: "Página 24: Las cucarachas, moscas y roedores son plagas comunes que transmiten graves infecciones a los alimentos." },
  { q: "¿El secado de vajilla debe hacerse preferentemente con repasadores de tela de uso continuo?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 22: Se recomienda el secado al aire o el uso de toallas de papel desechable, evitando los repasadores de tela." },
  { q: "¿A qué distancia mínima del suelo deben almacenarse las materias primas en las bodegas?", o: ["15 cm", "2 cm", "A nivel del piso"], a: "15 cm", r: "Página 28: Las materias primas deben estibarse sobre tarimas o estantes a una altura no menor a 15 cm del piso." },
  { q: "¿Es aceptable comer, fumar o masticar chicle en las áreas de preparación de alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: Está prohibido comer, fumar o masticar chicle en las zonas donde se manipulan alimentos." },
  { q: "¿Qué síntoma en un manipulador de alimentos obliga a suspender temporalmente sus labores?", o: ["Diarrea o vómitos", "Dolor muscular leve", "Cansancio o fatiga"], a: "Diarrea o vómitos", r: "Página 19: Cualquier manipulador que presente diarrea, vómitos o fiebre debe ser apartado de la manipulación." },
  { q: "¿La leche cruda sin pasteurizar es segura para el consumo directo?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 10: La leche debe ser pasteurizada o hervida para eliminar gérmenes patógenos como Brucella o Mycobacterium." },
  { q: "¿Cómo deben guardarse los desperdicios o basura dentro de la cocina?", o: ["En recipientes abiertos para ventilación", "En tachos lavables con bolsa y tapa", "En bolsas sobre el piso"], a: "En tachos lavables con bolsa y tapa", r: "Página 23: Los recipientes para basura deben contar con bolsa plástica, tapa accionada preferentemente a pedal y ser lavables." },
  { q: "¿Qué efecto tiene el frío de la congelación sobre las bacterias presentes en el alimento?", o: ["Las destruye por completo", "Detiene su multiplicación sin eliminarlas necesariamente", "Aumenta su velocidad de reproducción"], a: "Detiene su multiplicación sin eliminarlas necesariamente", r: "Página 31: La congelación inhibe la multiplicación bacteriana, pero los microorganismos pueden multiplicarse al descongelar." },
  { q: "¿Las frutas y verduras que se consumen crudas deben lavarse y desinfectarse antes de su preparación?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Anexo: Lave cuidadosamente las frutas y hortalizas, especialmente si se comen crudas." },
  { q: "¿Qué tipo de calzado es el recomendado para el personal que trabaja en cocina?", o: ["Sandalias abiertas", "Zapatos cerrados con suela antideslizante", "Zapatillas de tela"], a: "Zapatos cerrados con suela antideslizante", r: "Página 18: El calzado debe ser cerrado, de material impermeable y con suela antideslizante para evitar accidentes y contaminación." },
  { q: "¿Es seguro mantener las preparaciones con huevo crudo a temperatura ambiente?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 6: Las preparaciones a base de huevo crudo (mayonesas caseras) son de muy alto riesgo de Salmonella y deben mantenerse refrigeradas o evitarse." },
  { q: "¿El vinagre o el jugo de limón reemplazan de forma efectiva a los desinfectantes clorados?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 21: Los remedios caseros como vinagre o limón no garantizan la desinfección adecuada contra patógenos alimentarios." },
  { q: "¿Qué información fundamental debe revisarse al recibir materia prima envasada?", o: ["Solo el diseño del paquete", "La fecha de vencimiento y el estado del envase", "El peso estimado a simple vista"], a: "La fecha de vencimiento y el estado del envase", r: "Página 27: Al recepcionar alimentos, verifique la fecha de caducidad, integridad de los envases y la temperatura de llegada." },
  { q: "¿El lavado de manos debe realizarse únicamente al iniciar la jornada de trabajo?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 17: Las manos deben lavarse frecuentemente, antes de tocar alimentos, después de ir al baño y tras manipular basura o insumos crudos." },
  { q: "¿Qué enfermedad se asocia comúnmente al consumo de conservas caseras mal elaboradas?", o: ["Botulismo", "Gripe A", "Tuberculosis"], a: "Botulismo", r: "Página 8: El botulismo está frecuentemente asociado al consumo de conservas caseras mal esterilizadas." },
  { q: "¿Qué temperatura debe alcanzar el centro térmico de la carne de ave para asegurar su inocuidad?", o: ["Al menos 74°C", "Al menos 40°C", "Al menos 50°C"], a: "Al menos 74°C", r: "Página 34: Las carnes de ave deben alcanzar una temperatura interna de al menos 74°C durante la cocción." },
  { q: "¿Es correcto utilizar el mismo uniforme de trabajo fuera de las instalaciones del establecimiento?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: La ropa de trabajo debe ser de uso exclusivo dentro de la planta o área de preparación de alimentos." },
  { q: "¿Cuál es la función del pelo recogido y el uso de gorro o cofia en la cocina?", o: ["Evitar la caída de cabellos y reducir la contaminación física y microbiológica", "Solo por motivos de estética personal", "Para mantener la cabeza abrigada"], a: "Evitar la caída de cabellos y reducir la contaminación física y microbiológica", r: "Página 18: El uso de cofia o gorro cubre totalmente el cabello para prevenir la caída de pelos en los alimentos preparados." },
  { q: "¿Cuál es una de las causas más frecuentes de intoxicación por Listeria monocytogenes?", o: ["Consumo de lácteos no pasteurizados y fiambres", "Consumo de frutas secas", "Consumo de agua embotellada"], a: "Consumo de lácteos no pasteurizados y fiambres", r: "Página 9: La Listeria se encuentra en productos como quesos frescos, leche sin pasteurizar y fiambres." },
  { q: "¿Es seguro descongelar alimentos directamente bajo un chorro de agua caliente?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 35: Nunca debe usarse agua caliente para descongelar, ya que eleva la temperatura superficial favoreciendo las bacterias." },
  { q: "¿Qué se debe hacer con la comida servida que regresó de la mesa del cliente y no fue consumida?", o: ["Reutilizarla en otra preparación", "Desecharla inmediatamente", "Guardarla en refrigeración para el día siguiente"], a: "Desecharla inmediatamente", r: "Página 30: Los sobrantes de comida que han salido al comedor o mesa de los clientes deben ser descartados." },
  { q: "¿El uso de guantes reemplaza la necesidad de lavarse las manos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 17: El uso de guantes no sustituye el lavado de manos; deben lavarse las manos antes de ponérselos y al cambiarlos." },
  { q: "¿A qué se le denomina contaminación física en un alimento?", o: ["A la presencia de bacterias o virus", "A la presencia de objetos extraños como vidrios, plásticos o pelos", "A la presencia de restos de detergente"], a: "A la presencia de objetos extraños como vidrios, plásticos o pelos", r: "Página 11: La contaminación física se debe a la presencia de cuerpos extraños como metal, vidrio, madera o cabellos." },
  { q: "¿Es adecuado enfriar una olla grande de comida caliente metiéndola directamente al refrigerador?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 32: Volúmenes grandes calientan el interior del refrigerador; se debe fraccionar en recipientes poco profundos antes de refrigerar." },
  { q: "¿Cuál es el riesgo de usar productos de limpieza con aromas fuertes en las zonas de cocina?", o: ["Ninguno, ayudan a que huela bien", "Pueden transmitir olores y contaminar químicamente los alimentos", "Aumentan la temperatura del ambiente"], a: "Pueden transmitir olores y contaminar químicamente los alimentos", r: "Página 21: Los desinfectantes o limpiadores con perfumes fuertes pueden contaminar quimicamente los alimentos por absorción de olores." },
  { q: "¿Las latas de conservas abiertas se pueden guardar en la heladera dentro del mismo envase de lata?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 29: Una vez abierta la lata, el contenido sobrante debe trasvasarse a un recipiente de plástico o vidrio para su refrigeración." },
  { q: "¿Cuál es el tiempo máximo recomendado para mantener alimentos cocinados servidos en un bufé en la zona de peligro?", o: ["Máximo 2 horas", "Toda la jornada laboral", "Hasta 8 horas"], a: "Máximo 2 horas", r: "Anexo: Los alimentos que permanezcan en la zona de peligro por más de 2 horas deben ser descartados." },
  { q: "¿Qué microorganismo patógeno suele habitar en la piel, nariz o garganta de personas sanas?", o: ["Staphylococcus aureus", "Vibrio cholerae", "Trichinella spiralis"], a: "Staphylococcus aureus", r: "Página 7: El Staphylococcus aureus se encuentra en la piel, heridas infectadas, nariz y garganta de las personas." },
  { q: "¿Se permite el uso de esmalte de uñas en el personal que manipula alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 17: Las uñas deben estar cortas, limpias y sin esmalte, ya que este puede desprenderse y caer en la comida." },
  { q: "¿Cuál es la forma correcta de comprobar la temperatura de cocción de una carne?", o: ["Cortarla por la mitad visualmente", "Usar un termómetro de hincado en el centro grueso de la pieza", "Tocar la superficie con la mano"], a: "Usar un termómetro de hincado en el centro grueso de la pieza", r: "Página 34: La única forma segura de verificar la temperatura interna de cocción es mediante un termómetro de alimentos." },
  { q: "¿Qué tipo de contaminación ocurre si caen gotas de insecticida sobre una superficie de trabajo?", o: ["Contaminación química", "Contaminación biológica", "Contaminación física"], a: "Contaminación química", r: "Página 11: La contaminación química se produce por la presencia de plaguicidas, detergentes u otros químicos en los alimentos." },
  { q: "¿Qué se debe hacer con los productos congelados al momento de su recepción?", o: ["Dejarlos sobre la mesa para revisar más tarde", "Almacenarlos inmediatamente en la cámara de congelación", "Lavar los envases con agua tibia"], a: "Almacenarlos inmediatamente en la cámara de congelación", r: "Página 27: Los productos congelados deben ingresarse de inmediato al congelador para no romper la cadena de frío." },
  { q: "¿Es seguro consumir carne picada o molida que quede rosada o cruda en el centro?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 34: La carne picada debe cocinarse completamente hasta que no queden partes rosadas para prevenir Escherichia coli." },
  { q: "¿Qué es la 'cadena de frío'?", o: ["Mantener los alimentos bajo congelación extrema continuamente sin importar la cocción", "El sistema de conservación continua de temperatura adecuada para alimentos refrigerados o congelados", "El uso de hielo únicamente al transportar jugos"], a: "El sistema de conservación continua de temperatura adecuada para alimentos refrigerados o congelados", r: "Página 31: La cadena de frío garantiza que los alimentos perecederos se mantengan dentro de rangos seguros desde su origen hasta el consumo." },
  { q: "¿Cuál es la regla fundamental para el lavado de hortalizas de hoja verde?", o: ["Remojar solo en agua limpia", "Lavar hoja por hoja bajo chorro de agua potable y luego desinfectar", "Pasarles un paño húmedo"], a: "Lavar hoja por hoja bajo chorro de agua potable y luego desinfectar", r: "Página 33: Las verduras de hoja se deben lavar hoja por hoja para quitar la tierra y luego sumergir en solución desinfectante." },
  { q: "¿Qué peligro principal acarrea la presencia de moscas en el área de cocina?", o: ["Son un peligro físico menor", "Transportan bacterias patógenas en sus patas y saliva desde la basura a la comida", "Consumen demasiado alimento"], a: "Transportan bacterias patógenas en sus patas y saliva desde la basura a la comida", r: "Página 24: Las moscas se posan sobre excrementos y basura, transportando gérmenes directamente a los alimentos." },
  { q: "¿Se deben lavar los huevos con agua antes de guardarlos en el refrigerador?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 33: No se deben lavar los huevos antes de almacenarlos porque el agua elimina la capa protectora y facilita la entrada de bacterias." },
  { q: "¿A qué se refiere el término 'Inocuidad de los alimentos'?", o: ["A que el alimento sea económico y sabroso", "A la garantía de que el alimento no causará daño a la salud del consumidor", "A que los alimentos provengan de huertas orgánicas"], a: "A la garantía de que el alimento no causará daño a la salud del consumidor", r: "Página 4: La inocuidad es la condición de los alimentos que garantiza que no causarán daño al consumidor cuando se preparen y consuman." },
  { q: "¿Cuál es una práctica adecuada para evitar la entrada de plagas en el establecimiento?", o: ["Colocar mosquiteros en ventanas y mantener rejillas con malla fina", "Dejar las puertas abiertas para que ventile la cocina", "Usar veneno en polvo directo en los estantes de alimentos"], a: "Colocar mosquiteros en ventanas y mantener rejillas con malla fina", r: "Página 25: Las barreras físicas como telas mosquiteras en ventanas y rejillas previenen el ingreso de plagas a las instalaciones." },
  { q: "¿Es permitido probar la comida con la misma cuchara de madera que se usa para mezclar la preparación?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: Para probar las comidas se debe usar una cuchara limpia y destinarla solo a ese fin, nunca la misma con la que se cocina." },
  { q: "¿Qué tipo de bacterias se multiplican adecuadamente incluso en temperaturas de refrigeración?", o: ["Bacterias psicrófilas", "Bacterias termófilas", "Bacterias mesófilas"], a: "Bacterias psicrófilas", r: "Página 15: Las bacterias psicrófilas son capaces de desarrollarse a temperaturas bajas o de refrigeración." },
  { q: "¿Cuál es el porcentaje mínimo recomendado de alcohol para la desinfección rápida de manos en seco?", o: ["70%", "30%", "100%"], a: "70%", r: "Página 17: Para desinfección rápida de manos se utiliza solución de alcohol al 70%." },
  { q: "¿El virus de la Hepatitis A puede transmitirse por la manipulación de alimentos contaminados?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 10: La Hepatitis A se transmite por vía fecal-oral a través de alimentos o agua contaminados por manipuladores infectados." },
  { q: "¿Qué se debe verificar en el transporte de carnes frescas al recibir la mercadería?", o: ["Que el vehículo esté refrigerado y la carne a 5°C o menos", "Que el camión viaje con las ventanas abiertas", "Que la carne esté envuelta en papel periódico"], a: "Que el vehículo esté refrigerado y la carne a 5°C o menos", r: "Página 26: Las carnes frescas deben transportarse en vehículos refrigerados y llegar a temperaturas no mayores a 5°C." },
  { q: "¿Es obligatorio el uso de delantal o uniforme limpio al empezar el turno de trabajo?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 18: La vestimenta de trabajo debe estar limpia al inicio de la jornada para evitar contaminación de superficies." },
  { q: "¿Qué es la Triquinosis y cómo se contagia principalmente?", o: ["Un parásito transmitido por consumir carne de cerdo cruda o mal cocida", "Una bacteria presente en conservas de tomate", "Un virus del aire"], a: "Un parásito transmitido por consumir carne de cerdo cruda o mal cocida", r: "Página 10: La triquinosis es una enfermedad parasitaria provocada por la ingesta de carne de cerdo o jabalí cruda o mal cocida." },
  { q: "¿Qué acción se debe tomar con un alimento que huele mal pero su fecha de vencimiento aún no ha llegado?", o: ["Descartarlo por sospecha de alteración", "Cocinarlo a más de 100°C y consumirlo", "Mezclarlo con alimentos frescos"], a: "Descartarlo por sospecha de alteración", r: "Página 27: Alimentos con signos organolépticos alterados (mal olor, color extraño) no deben consumirse independientemente de la fecha." },
  { q: "¿Se pueden reutilizar los envases plásticos de productos químicos vacíos para guardar ingredientes culinarios?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 21: Queda totalmente prohibido el uso de envases de productos químicos para contener alimentos, debido a la grave contaminación química." },
  { q: "¿Cuál es la causa principal del Síndrome Urémico Hemolítico (SUH)?", o: ["Infección por Escherichia coli productora de toxina Shiga", "Consumo excesivo de sal", "Falta de vitaminas"], a: "Infección por Escherichia coli productora de toxina Shiga", r: "Página 7: El SUH es causado principalmente por cepas de Escherichia coli que producen toxinas en el intestino." },
  { q: "¿Es seguro utilizar la misma tabla para cortar vegetales crudos y carne cruda sin lavarla en el medio?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 12: Utilizar la misma tabla sin sanitizar produce contaminación cruzada indirecta entre alimentos." },
  { q: "¿A qué temperatura debe mantenerse la comida caliente lista para servir en un buffet?", o: ["Por encima de 60°C", "Entre 20°C y 40°C", "A temperatura ambiente"], a: "Por encima de 60°C", r: "Anexo: Mantenga la comida servida muy caliente, por encima de los 60°C." },
  { q: "¿La cocción completa elimina las esporas y toxinas de todas las bacterias?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 8: Algunas toxinas y esporas bacterianas son resistentes al calor y sobreviven a la cocción normal." },
  { q: "¿Qué medida se debe tomar si se rompe un vaso de vidrio en la zona de preparación de alimentos?", o: ["Desechar los alimentos expuestos y limpiar exhaustivamente la zona", "Barrer rápidamente y continuar cocinando", "Filtrar la comida con un colador"], a: "Desechar los alimentos expuestos y limpiar exhaustivamente la zona", r: "Página 11: Los fragmentos de vidrio representan un grave riesgo físico; cualquier alimento cercano susceptible de contaminación debe ser descartado." },
  { q: "¿Es adecuado usar paños de cocina húmedos para retirar ollas calientes del fuego?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 22: El uso de paños húmedos transmite el calor rápidamente provocando quemaduras y además acumula microorganismos." },
  { q: "¿Qué enfermedad viral se transmite principalmente por el consumo de moluscos bivalvos cosechados en aguas contaminadas?", o: ["Norovirus", "Tétanos", "Dengue"], a: "Norovirus", r: "Página 10: El Norovirus causa gastroenteritis y se transmite con frecuencia por moluscos o agua contaminada." },
  { q: "¿Cuál es el método adecuado para enfriar rápidamente un caldo o sopa caliente antes de refrigerar?", o: ["Utilizar un baño de María invertido con agua y hielo", "Dejar la olla tapada en la mesada toda la noche", "Soplarlos constantemente"], a: "Utilizar un baño de María invertido con agua y hielo", r: "Página 32: El enfriamiento rápido mediante baño de agua fría con hielo reduce el tiempo que el alimento pasa en la zona de peligro." },
  { q: "¿Los productos químicos de limpieza deben guardarse en sus envases originales etiquetados?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 21: Todos los productos de limpieza deben mantenerse en sus envases originales con la etiqueta visible para evitar confusiones." },
  { q: "¿Qué humedad relativa aproximada se recomienda para el almacenamiento de granos y productos secos?", o: ["Baja humedad, entre 50% y 60%", "Humedad alta del 90%", "No importa la humedad"], a: "Baja humedad, entre 50% y 60%", r: "Página 29: Los depósitos de secos deben mantenerse secos y bien ventilados con humedad relativa reducida para evitar mohos." },
  { q: "¿Cuál es la función principal del manipulador de alimentos respecto a la salud pública?", o: ["Garantizar la inocuidad y prevenir las enfermedades transmitidas por alimentos", "Decorar los platillos de forma vistosa", "Vender la mayor cantidad de productos"], a: "Garantizar la inocuidad y prevenir las enfermedades transmitidas por alimentos", r: "Página 4: La responsabilidad del manipulador es garantizar la inocuidad del producto final para proteger la salud de los consumidores." },
  { q: "¿Se puede estornudar sobre la manga del uniforme en el área de cocina si no hay pañuelos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: Si necesita estornudar, debe alejarse de los alimentos, usar un pañuelo desechable y lavarse las manos inmediatamente." },
  { q: "¿Qué característica debe tener el bote de basura ubicado en el sector de lavado de manos?", o: ["Tener tapa con pedal", "Estar abierto para mayor comodidad", "Ser de cartón"], a: "Tener tapa con pedal", r: "Página 17: Los basureros deben operarse sin contacto manual directo, utilizando mecanismo de pedal." },
  { q: "¿Las bacterias necesitan humedad para multiplicarse activa y rápidamente?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 15: La disponibilidad de agua (humedad) es un factor determinante para el desarrollo de la mayoría de las bacterias." },
  { q: "¿Qué se debe hacer si se detecta un envasado al vacío inflado o abombado?", o: ["Descartar el producto por sospecha de desarrollo bacteriano", "Abrir la bolsa y cocinarlo inmediatamente", "Congelarlo para aplastarlo"], a: "Descartar el producto por sospecha de desarrollo bacteriano", r: "Página 27: El abombamiento en envases al vacío indica generación de gases por microorganismos anaerobios y no debe consumirse." },
  { q: "¿El uso de delantal de plástico impermeable es recomendado para qué tarea específica?", o: ["Para el lavado de vajilla y manipulación de productos húmedos crudos", "Para cocinar en el horno", "Para atender la caja registradora"], a: "Para el lavado de vajilla y manipulación de productos húmedos crudos", r: "Página 18: El delantal plástico protege la indumentaria de salpicaduras de agua sucia durante las tareas de higienización." },
  { q: "¿Cuál es el peligro de descongelar un alimento directamente en el microondas si no se cocina de inmediato?", o: ["Que se creen zonas tibias donde las bacterias se multipliquen rápidamente", "Que el alimento pierda todo su sabor", "Que la vajilla se rompa"], a: "Que se creen zonas tibias donde las bacterias se multipliquen rápidamente", r: "Página 35: Si se descongela en microondas, debe cocinarse de inmediato porque parte del alimento alcanza temperaturas de la zona de peligro." },
  { q: "¿Qué tipo de luz o iluminación es la recomendada sobre las áreas de preparación de alimentos?", o: ["Luces protegidas con difusores anticaídas contra roturas de vidrio", "Velas o luces tenues", "Lámparas incandescentes descubiertas"], a: "Luces protegidas con difusores anticaídas contra roturas de vidrio", r: "Página 23: Las luminarias deben contar con protección para evitar que los fragmentos caigan sobre la comida en caso de estallido." },
  { q: "¿La cocción por microondas cocina los alimentos de manera uniforme en todas sus partes?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 34: El microondas suele generar calentamiento irregular, requiriendo reposo y mezclado para unificar la temperatura." },
  { q: "¿Qué es un 'alimento alterado'?", o: ["Aquél que por causas naturales ha sufrido deterioros en sus características organolépticas", "Un alimento que contiene un veneno intencional", "Un alimento preparado con ingredientes caros"], a: "Aquél que por causas naturales ha sufrido deterioros en sus características organolépticas", r: "Página 5: Alimento alterado es el que por causas físicas, químicas o biológicas ha sufrido modificaciones en sus propiedades habituales." },
  { q: "¿Qué representa la sigla 'ETA' en seguridad alimentaria?", o: ["Enfermedades Transmitidas por Alimentos", "Evaluación Técnica de Alimentos", "Estrategia Total de Almacenamiento"], a: "Enfermedades Transmitidas por Alimentos", r: "Página 5: Las ETA son aquellas enfermedades causadas por el consumo de alimentos o agua contaminados." },
  { q: "¿Los alimentos con alto contenido de azúcar o sal (como mermeladas o cecinas) son menos propensos al desarrollo bacteriano rápido?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 15: Los altos niveles de azúcar o sal reducen el agua disponible, dificultando la multiplicación de bacterias." },
  { q: "¿Es aconsejable barrer en seco la cocina mientras se están preparando alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 22: El barrido en seco levanta polvo y microorganismos en suspensión que caen sobre los alimentos listos para consumir." },
  { q: "¿A partir de qué temperatura de congelación se detiene completamente la multiplicación celular de la mayoría de bacterias?", o: ["A los -18°C", "A los 0°C", "A los -2°C"], a: "A los -18°C", r: "Página 31: A -18°C el agua en el alimento se inmoviliza y la multiplicación microbiana se detiene por completo." },
  { q: "¿Qué información debe contener la etiqueta de un producto elaborado internamente para guardar en refrigeración?", o: ["Nombre del producto y fecha de elaboración/vencimiento", "Solo el nombre del cocinero", "El costo de los ingredientes"], a: "Nombre del producto y fecha de elaboración/vencimiento", r: "Página 29: Todo alimento fraccionado o elaborado debe identificarse con su nombre y fecha límite para garantizar el rotado PEPS." },
  { q: "¿Se puede permitir el ingreso de mascotas o animales domésticos a la zona de almacén o cocina?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 24: Queda prohibida la presencia de animales domésticos en los lugares donde se preparan o almacenan alimentos." },
  { q: "¿Qué síntoma cutáneo en un manipulador requiere cubrirse de forma obligatoria para trabajar?", o: ["Erupciones o forúnculos infectados", "Lunares de nacimiento", "Piel seca"], a: "Erupciones o forúnculos infectados", r: "Página 19: Las lesiones cutáneas e infecciones en la piel albergan Staphylococcus aureus y deben cubrirse con vendajes impermeables." },
  { q: "¿Es correcto guardar cajas de cartón corrugado de proveedores directamente dentro de las cámaras frigoríficas?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 28: El cartón absorbe humedad, se deteriora y representa una fuente de contaminación física y biológica dentro de las cámaras." },
  { q: "¿Cuál es el propósito del proceso de pasteurización en productos como la leche o jugos?", o: ["Destruir los microorganismos patógenos mediante tratamiento térmico moderado", "Hacer que el producto nunca se venza", "Aumentar la cantidad de grasa del producto"], a: "Destruir los microorganismos patógenos mediante tratamiento térmico moderado", r: "Página 10: La pasteurización reduce la carga microbiana eliminando patógenos sin alterar drásticamente la calidad nutricional." },
  { q: "¿Qué actitud se debe tomar ante una sospecha de brote epidemiológico por ETA en un establecimiento?", o: ["Notificar de inmediato a las autoridades sanitarias y conservar las muestras", "Ocultar la comida sobrante y lavar todo rápidamente", "Cambiar el menú del día siguiente"], a: "Notificar de inmediato a las autoridades sanitarias y conservar las muestras", r: "Página 36: Ante un brote de ETA es obligatorio dar aviso a la autoridad de salud para la investigación correspondiente." },
  { q: "¿Cuál es el riesgo de permitir que los tachos de basura se llenen en exceso?", o: ["Atraer plagas y generar contaminación cruzada en el ambiente", "Aumentar la temperatura de la cocina", "Gastar más bolsas de basura"], a: "Atraer plagas y generar contaminación cruzada en el ambiente", r: "Página 23: El colapso o sobrellenado de depósitos de residuos atrae vectores de plagas y contamina las áreas contiguas." },
  { q: "¿Es seguro descongelar alimentos sumergiéndolos directamente en agua estancada a temperatura ambiente?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 35: El agua estancada a temperatura ambiente favorece la multiplicación bacteriana en la superficie del alimento." },
  { q: "¿Qué medida preventiva reduce el riesgo de transmisión de parásitos en pescados destinados a consumo crudo (como el sushi)?", o: ["Congelación previa a -20°C por al menos 24 a 48 horas", "Lavar el pescado con jugo de limón", "Salarlo moderadamente antes de servir"], a: "Congelación previa a -20°C por al menos 24 a 48 horas", r: "Página 10: La congelación previa a temperaturas de -20°C inactiva parásitos como Anisakis en pescados destinados a consumo crudo." },
  { q: "¿Se puede almacenar comida caliente directamente en recipientes de plástico no aptos para alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 11: Los plásticos no aptos pueden migrar sustancias químicas nocivas al alimento por efecto del calor." },
  { q: "¿Cuál es la función del proceso de sanitización o desinfección de verduras mediante cloro?", o: ["Reducir la carga de microorganismos patógenos en la superficie", "Darle mejor color y brillo a las hojas", "Eliminar el sabor amargo de los vegetales"], a: "Reducir la carga de microorganismos patógenos en la superficie", r: "Página 33: La desinfección con soluciones cloradas busca eliminar o reducir a niveles seguros los microorganismos presentes en hortalizas." },
  { q: "¿Es correcto secarse las manos con el delantal o la ropa de trabajo tras el lavado?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 17: Secarse con la vestimenta o ropa de trabajo contamina nuevamente las manos recién lavadas." },
  { q: "¿Qué microorganismo es el responsable habitual de la Intoxicación Estafilocócica en alimentos cocidos y manipulados?", o: ["Staphylococcus aureus", "Salmonella enteritidis", "Vibrio parahaemolyticus"], a: "Staphylococcus aureus", r: "Página 7: El Staphylococcus aureus produce una enterotoxina resistente al calor cuando los alimentos manipulados se dejan a temperatura ambiente." },
  { q: "¿A qué altura mínima respecto a la pared se deben colocar los estantes de almacenamiento para permitir la limpieza?", o: ["A una distancia que permita la ventilación e inspección, aprox. 5 cm a 10 cm", "Pegados completamente a la pared", "A más de 1 metro de la pared"], a: "A una distancia que permita la ventilación e inspección, aprox. 5 cm a 10 cm", r: "Página 28: La separación de estantes respecto a paredes y piso permite la correcta ventilación, inspección y limpieza de las áreas." },
  { q: "¿Los productos de limpieza y desinfección pueden prepararse en contenedores de bebidas o refrescos vacíos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 21: Trasvasar químicos a envases de alimentos o bebidas es una de las causas más graves de intoxicación química accidental." },
  { q: "¿Qué síntoma inicial provoca la ingestión de la toxina botulínica?", o: ["Visión doble, dificultad para tragar y parálisis muscular progresiva", "Fiebre alta repentina y erupción en la piel", "Dolor en las articulaciones"], a: "Visión doble, dificultad para tragar y parálisis muscular progresiva", r: "Página 8: La neurotoxina de Clostridium botulinum causa trastornos neurológicos como visión borrosa o doble, dificultad respiratoria y parálisis." },
  { q: "¿Es seguro mantener mayonesas preparadas comercialmente a temperatura ambiente una vez abierto el frasco?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 30: Una vez abierto el envase comercial de mayonesa u otros aderezos, debe mantenerse estrictamente bajo refrigeración." },
  { q: "¿Qué tipo de contaminación ocurre cuando se utilizan recipientes de plomo o cobre para cocinar alimentos ácidos?", o: ["Contaminación química", "Contaminación física", "Contaminación biológica"], a: "Contaminación química", r: "Página 11: Los metales pesados como el plomo, cobre o cadmio se disuelven en medios ácidos originando contaminación química." },
  { q: "¿Los insectocutores (lámparas atrapainsectos) deben colocarse justo encima de la mesa de preparación de alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 25: Las trampas de luz uv no deben ubicarse sobre zonas donde haya alimentos expuestos para evitar que caigan restos de insectos sobre la comida." },
  { q: "¿Cuál es la norma de conducta sobre el cabello en las áreas de cocina para el personal masculino con barba o bigote?", o: ["Deberán usar cubrebarba o mantener el vello facial recortado y cubierto", "Pueden dejar la barba suelta si no es muy larga", "Es opcional si usan gorro"], a: "Deberán usar cubrebarba o mantener el vello facial recortado y cubierto", r: "Página 18: El vello facial debe mantenerse cubierto mediante cubrebarba para impedir la caída de vellos en los alimentos." },
  { q: "¿Qué alimento presenta un elevado riesgo de contaminación por Bacillus cereus si se mantiene a temperatura ambiente tras ser cocinado?", o: ["Arroz cocido y pastas", "Carne de res magra", "Quesos madurados"], a: "Arroz cocido y pastas", r: "Página 9: El Bacillus cereus forma esporas que sobreviven a la cocción y proliferan en platos ricos en almidón como el arroz a temperatura ambiente." },
  { q: "¿Es obligatorio realizar un examen médico periódico a los manipuladores de alimentos?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 16: El manipulador debe contar con el carné de salud o control médico vigente para certificar la ausencia de enfermedades transmisibles." },
  { q: "¿Cómo deben almacenarse los mariscos y pescados frescos dentro del refrigerador?", o: ["En recipientes con hielo molido y drenaje, en el estante inferior", "En el estante superior junto a la repostería", "A temperatura ambiente dentro de bolsas plásticas"], a: "En recipientes con hielo molido y drenaje, en el estante inferior", r: "Página 31: El pescado fresco debe conservarse entre 0°C y 2°C con hielo escamado y drenaje para prevenir el deterioro acelerado." },
  { q: "¿Las manos deben lavarse obligatoriamente después de tocar dinero o cobro a clientes?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 17: El dinero es un objeto altamente manipulado y sucio; se deben lavar las manos tras tocarlo y antes de volver a preparar alimentos." },
  { q: "¿Qué se entiende por 'alimento adulterado'?", o: ["Aquél al que se le han privado parcialmente o sustituido componentes por razones fraudulentas", "Un alimento infectado por bacterias de forma natural", "Un alimento vencido en su envase original"], a: "Aquél al que se le han privado parcialmente o sustituido componentes por razones fraudulentas", r: "Página 5: Alimento adulterado es el que ha sido privado de elementos característicos para disimular su inferior calidad o engañar al comprador." },
  { q: "¿Qué medida se aconseja tomar respecto al manejo del hielo de consumo?", o: ["Manipularlo únicamente con pinzas o palas limpias, nunca con las manos directas", "Tomarlo directamente con la mano limpia", "Usar vasos de vidrio sumergidos en la máquina de hielo"], a: "Manipularlo únicamente con pinzas o palas limpias, nunca con las manos directas", r: "Página 33: El hielo considerado alimento debe servirse siempre con utensilios higienizados para evitar contaminación manual." },
  { q: "¿Es permitido el uso de tiritas o curitas comunes sin recubrimiento impermeable al manipular alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: Las tiritas comunes no son impermeables y permiten el paso de humedad y bacterias; deben recubrirse con dediles o guantes." },
  { q: "¿A qué temperatura de almacenamiento el crecimiento microbiano en verduras frescas se enlentece significativamente sin dañarse por congelación?", o: ["Entre 5°C y 8°C", "A 20°C", "A -5°C"], a: "Entre 5°C y 8°C", r: "Página 29: Las verduras y frutas frescas se conservan mejor en refrigeración a temperaturas moderadas entre 5°C y 8°C." },
  { q: "¿Qué es un alergeno alimentario?", o: ["Una sustancia contenida en los alimentos que puede desencadenar una respuesta inmune grave en personas sensibles", "Una bacteria patógena de transmisión hídrica", "Un aditivo autorizado para conservar alimentos"], a: "Una sustancia contenida en los alimentos que puede desencadenar una respuesta inmune grave en personas sensibles", r: "Página 13: Los alergenos son componentes (como maní, leche o mariscos) capaces de generar reacciones alérgicas severas en el organismo." },
  { q: "¿Se pueden preparar alimentos sobre superficies de trabajo que presenten grietas o fisuras?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 22: Las grietas acumulan humedad, grasa y restos orgánicos donde las bacterias se alojan sin poder ser eliminadas en la limpieza." },
  { q: "¿Cuál es el principal riesgo de consumir lácteos o jugos sin pasteurizar?", o: ["Contracción de patógenos como Brucella, E. coli o Salmonella", "Pérdida de vitaminas", "Exceso de minerales en el cuerpo"], a: "Contracción de patógenos como Brucella, E. coli o Salmonella", r: "Página 10: Los productos sin pasteurización pueden albergar bacterias patógenas viables que provocan severas infecciones gastrointestinales." },
  { q: "¿Cuál es la frecuencia recomendada para retirar la basura de las zonas de manipulación de alimentos?", o: ["Al menos una vez al día o cada vez que sea necesario al llenarse", "Una vez por semana", "Únicamente cuando se generen malos olores"], a: "Al menos una vez al día o cada vez que sea necesario al llenarse", r: "Página 23: Los desechos deben retirarse periódicamente de las áreas de trabajo para mantener la higiene y evitar plagas." },
  { q: "¿Es apto lavar pollos o carnes crudas en la pileta de la cocina antes de su cocción?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 33: Lavar carne de ave salpica bacterias (como Campylobacter o Salmonella) a las piletas, mesadas y utensilios circundantes." },
  { q: "¿Qué riesgo presenta la reutilización de aceites de fritura degradados o demasiado usufructuados?", o: ["Formación de compuestos tóxicos y alteración del sabor y salud del alimento", "Aumento excesivo del punto de ebullición del agua", "Reducción de las calorías del plato"], a: "Formación de compuestos tóxicos y alteración del sabor y salud del alimento", r: "Página 34: El aceite reusado en exceso genera acrilamidas y compuestos polares perjudiciales para la salud del consumidor." },
  { q: "¿Es seguro almacenar carne picada fresca en refrigeración por más de 24 a 48 horas sin cocinar?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 31: La carne picada presenta una gran superficie expuesta y debe cocinarse o congelarse dentro de las 24 a 48 horas de elaborada." },
  { q: "¿Cuál es el objetivo primordial del sistema HACCP / APPCC en la industria alimentaria?", o: ["Identificar, evaluar y controlar los peligros significativos para la inocuidad de los alimentos", "Controlar los horarios de los empleados", "Calcular los costos de producción"], a: "Identificar, evaluar y controlar los peligros significativos para la inocuidad de los alimentos", r: "Página 36: El sistema de Análisis de Peligros y Puntos Críticos de Control busca garantizar la inocuidad mediante la prevención de riesgos." },
  { q: "¿Cuál es el riesgo de permitir la acumulación de humedad o condensación en los techos de las zonas de preparación?", o: ["Goteo de agua contaminada sobre los alimentos e instalaciones", "Aumento en la factura de agua", "Mal aspecto del diseño"], a: "Goteo de agua contaminada sobre los alimentos e instalaciones", r: "Página 23: La condensación en techos favorece el goteo de microorganismos y moho directamente sobre las áreas de trabajo." },
  { q: "¿Es seguro descongelar grandes trozos de carne en un recipiente con agua tibia sobre la mesa?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 35: El agua tibia acelera la multiplicación rápida de bacterias en las zonas externas de la carne mientras el centro sigue congelado." },
  { q: "¿Qué se debe hacer con los utensilios de cocina que entran en contacto con carne de ave cruda?", o: ["Lavarlos y desinfectarlos inmediatamente antes de usarlos con otro alimento", "Limpiarlos solo con papel secante", "Guardarlos directamente en el cajón"], a: "Lavarlos y desinfectarlos inmediatamente antes de usarlos con otro alimento", r: "Página 12: Todo utensilio en contacto con carnes crudas debe ser sometido a lavado y desinfección antes de ser reutilizado." },
  { q: "¿El virus de Norovirus resiste en superficies secas durante varios días?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 10: Los virus entéricos como el Norovirus presentan gran resistencia ambiental y pueden persistir en superficies." },
  { q: "¿Qué material es el más adecuado para las mesas de trabajo en cocinas profesionales?", o: ["Acero inoxidable", "Madera contrachapada", "Marmita de barro"], a: "Acero inoxidable", r: "Página 22: El acero inoxidable es un material liso, no poroso, lavable y fácil de desinfectar." },
  { q: "¿Es recomendable usar adornos o uñas postizas en manipuladores que usan guantes?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 17: Las uñas postizas pueden romperse o perforar los guantes, generando riesgo físico y bacteriológico." },
  { q: "¿Cuál es la principal vía de contaminación en los brotes por consumo de mariscos crudos?", o: ["Agua de mar contaminada por aguas residuales o mar poeticas toxinas", "Uso excesivo de hielo limpio", "Exposición prolongada al aire libre"], a: "Agua de mar contaminada por aguas residuales o mar poeticas toxinas", r: "Página 10: Los mariscos filtran grandes cantidades de agua y retienen bacterias, virus o toxinas marinas si el agua está contaminada." },
  { q: "¿Qué efecto tiene el uso de agua a más de 80°C durante el enjuague de la vajilla?", o: ["Actúa como un agente de desinfección térmica", "Daña irreversiblemente el metal de las ollas", "Genera bacterias termófilas"], a: "Actúa como un agente de desinfección térmica", r: "Página 21: El agua a alta temperatura (mayor a 80°C) sirve para lograr la desinfección por calor en el lavado de vajilla." },
  { q: "¿Se puede dejar enfriar una sopa recién hecha en la ventana abierta al aire libre?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 32: Dejar alimentos al aire libre facilita la llegada de plagas, polvo y contaminantes ambientales." },
  { q: "¿Qué microorganismo sp. suele contaminar los alimentos secos si no se almacenan con baja humedad relativa?", o: ["Hongos y mohos (Aspergillus, Penicillium)", "Vibrio cholerae", "Listeria monocytogenes"], a: "Hongos y mohos (Aspergillus, Penicillium)", r: "Página 29: El exceso de humedad en el almacenamiento de secos propicia el desarrollo de hongos y producción de micotoxinas." },
  { q: "¿Es seguro almacenar alimentos directamente en contacto con el piso dentro de la cámara de frío?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 28: Ningún alimento o recipiente debe apoyarse en el suelo; siempre deben estar sobre tarimas o estantes." },
  { q: "¿Qué debe hacerse con un manipulador de alimentos que padece una infección ocular purulenta (conjuntivitis)?", o: ["Apartarlo temporalmente de las labores de preparación", "Colocarle gafas de sol y dejarlo cocinar", "Permitirle trabajar solo en la zona de repostería"], a: "Apartarlo temporalmente de las labores de preparación", r: "Página 19: Infecciones en ojos, oídos o garganta son fuentes de microorganismos patógenos y requieren alejamiento del manipulador." },
  { q: "¿A qué se debe la presencia de Campylobacter en carnes de pollo mal cocidas?", o: ["Bacterias presentes en el tracto intestinal de las aves de corral", "Contaminación química por el envase", "Manejo en cámaras de congelación"], a: "Bacterias presentes en el tracto intestinal de las aves de corral", r: "Página 8: Campylobacter es muy común en la flora intestinal de las aves y se transmite por cocción insuficiente o contaminación cruzada." },
  { q: "¿Es permitido fumar en el área de recepción de insumos o materias primas?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: La prohibición de fumar aplica a todas las dependencias del establecimiento donde se reciban, almacenen o elaboren alimentos." },
  { q: "¿Cuál es el riesgo de cortar la cadena de frío en pescados de carne oscura como el atún o la caballa?", o: ["Formación de histamina (escombrotoxicosis)", "Solidificación de las grasas", "Cambio de color a verde sin peligro de salud"], a: "Formación de histamina (escombrotoxicosis)", r: "Página 9: La descomposición bacteriana de ciertos pescados desprotegidos de frío produce acumulación de histamina, generando intoxicación." },
  { q: "¿Qué acción se realiza primero al higienizar una superficie: aplicar desinfectante o remover restos de comida?", o: ["Remover restos de comida (limpieza previa)", "Aplicar desinfectante directo", "Secar con toalla de tela"], a: "Remover restos de comida (limpieza previa)", r: "Página 21: La desinfección es ineficaz en presencia de materia orgánica; por ello primero se realiza la limpieza y remoción de suciedad." },
  { q: "¿Las tablas de picar de polietileno de diferentes colores se utilizan para separar distintos tipos de alimentos?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 22: El código de colores en tablas de picar ayuda a prevenir la contaminación cruzada entre carnes crudas, vegetales y cocidos." },
  { q: "¿Se puede probar la temperatura del biberón o alimento infantil probando directamente con la boca del manipulador?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: El contacto bucal directo del manipulador con la comida o utensilios de consumo transfiere saliva y microorganismos." },
  { q: "¿Cuál es el tiempo máximo que pueden mantenerse refrigerados los platos preparados una vez elaborados (sin congelar)?", o: ["De 48 a 72 horas como máximo", "Hasta 2 semanas", "Un mes completo"], a: "De 48 a 72 horas como máximo", r: "Página 30: Los platos preparados deben consumirse o comercializarse en un período corto (48 a 72 horas) para garantizar su calidad e inocuidad." },
  { q: "¿Qué características debe tener la pared de una sala de manipulación de alimentos?", o: ["Superficie lisa, lavable, de color claro e impermeable", "Pintura rugosa para absorber humedad", "Recubierta de papel tapiz decorativo"], a: "Superficie lisa, lavable, de color claro e impermeable", r: "Página 23: Las paredes deben ser lisas, sin grietas, lavables y de colores claros para evidenciar la suciedad y facilitar la limpieza." },
  { q: "¿El uso de lavavajillas automáticos sustituye la etapa de eliminación de residuos gruesos de la vajilla?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 21: Los restos grandes de comida deben retirarse manualmente (descorche/desramado) antes de introducir la vajilla a la máquina." },
  { q: "¿Qué tipo de bacterias sobreviven y pueden multiplicarse en alimentos con baja presencia de oxígeno como embutidos curados?", o: ["Bacterias anaerobias o facultativas", "Bacterias aerobias estrictas", "Hongos filamentosos del aire"], a: "Bacterias anaerobias o facultativas", r: "Página 8: Los microorganismos anaerobios desarrollan su ciclo vital en ambientes privados de aire u oxígeno libre." },
  { q: "¿Es seguro almacenar carne de cerdo cruda en el mismo estante de la heladera con carne de res lista para consumir?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 31: Alimentos listos para consumir deben estar siempre en los estantes superiores y separados de cualquier carne cruda." },
  { q: "¿Qué se debe verificar respecto al drenaje o desagües en el suelo de la cocina?", o: ["Que cuenten con rejillas removibles y sifones antirretorno", "Que estén siempre tapados con cemento", "Que desemboquen directamente en la calle"], a: "Que cuenten con rejillas removibles y sifones antirretorno", r: "Página 23: Los drenajes deben poseer sifones o trampas de olor y rejillas para evitar el ingreso de plagas desde el alcantarillado." },
  { q: "¿Es obligatorio lavarse las manos tras manipular cajas de cartón o embalajes externos de mercadería?", o: ["Verdadero", "Falso"], a: "Verdadero", r: "Página 17: Los embalajes secundarios externos han estado en contacto con transporte y depósitos sucios, por lo que acumulan contaminación." },
  { q: "¿Qué síntoma provocado por Shigella se transmite por deficiencias graves en la higiene de manos?", o: ["Disentería (diarrea severa con sangre y moco)", "Caída de cabello", "Caries dentales"], a: "Disentería (diarrea severa con sangre y moco)", r: "Página 7: Shigella es transmitida por la ruta fecal-oral por manipuladores que no se lavan adecuadamente las manos tras ir al baño." },
  { q: "¿Cuál es la correcta forma de desinfectar mesas de madera en un establecimiento alimentario?", o: ["Reemplazarlas por superficies no porosas como acero o plástico", "Pintarlas con barniz cada semana", "Lavarlas con detergente y agua hirviendo sin secar"], a: "Reemplazarlas por superficies no porosas como acero o plástico", r: "Página 22: La madera está desaconsejada; la recomendación sanitaria es sustituirla por materiales lisos e inalterables." },
  { q: "¿Es seguro calentar un alimento en lata directamente sobre el fuego de la cocina?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 11: El calor directo destruye los barnices internos de la lata libando productos químicos peligrosos hacia la comida." },
  { q: "¿Qué tipo de envase se considera primario en el almacenamiento de alimentos?", o: ["El envase que está en contacto directo con el alimento", "La caja de cartón grande de transporte", "El palet de madera"], a: "El envase que está en contacto directo con el alimento", r: "Página 27: El envase primario es aquel que contiene directamente al producto alimenticio y debe ser de material apto para uso alimentario." },
  { q: "¿Qué debe verificar el manipulador en el termómetro de la cámara frigorífica diariamente?", o: ["Que mantenga la temperatura adecuada de lectura sin desviaciones fuera de rango", "Que tenga el cristal brillante", "Solo la marca del fabricante"], a: "Que mantenga la temperatura adecuada de lectura sin desviaciones fuera de rango", r: "Página 31: Se debe controlar y registrar la temperatura de las cámaras periódicamente para verificar la conservación segura." },
  { q: "¿Qué microorganismo es un hongo unicelular utilizado en la industria pero que puede alterar alimentos por fermentación no deseada?", o: ["Levaduras", "Parásitos", "Virus"], a: "Levaduras", r: "Página 14: Las levaduras son hongos unicelulares que pueden alterar alimentos ricos en azúcares mediante la fermentación." },
  { q: "¿A partir de qué nivel de pH se considera que un alimento es de baja acidez y favorece la multiplicación microbiana?", o: ["pH mayor a 4.5", "pH menor a 2.0", "pH igual a 1.0"], a: "pH mayor a 4.5", r: "Página 15: Los alimentos con un pH superior a 4.5 presentan mejores condiciones para el desarrollo de la mayoría de las bacterias." },
  { q: "¿Qué se debe hacer con los recipientes de desinfectantes concentrados al prepararlos?", o: ["Seguir estrictamente la dosificación del fabricante", "Mezclar el doble de producto para asegurar la efectividad", "Mezclarlos siempre con detergente en el mismo balde"], a: "Seguir estrictamente la dosificación del fabricante", r: "Página 21: La dosificación de los productos químicos debe hacerse según las instrucciones del fabricante para evitar toxicidad o ineficacia." },
  { q: "¿Es seguro mezclar hipoclorito de sodio (lavandina) con detergentes amoniacales o ácidos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 21: La mezcla de lavandina con amoníaco o ácidos libera gases tóxicos graves para la salud de los trabajadores." },
  { q: "¿Qué nombre recibe el proceso de eliminar el agua de un alimento mediante calor para prolongar su vida útil?", o: ["Deshidratación o secado", "Congelación rápida", "Escaldado"], a: "Deshidratación o secado", r: "Página 15: La deshidratación disminuye la actividad de agua (Aw) impidiendo la supervivencia de microorganismos." },
  { q: "¿Qué característica debe tener el flujo de trabajo dentro de una planta de alimentos?", o: ["Unidireccional ('Marcha hacia adelante')", "Cruzado entre áreas sucias y limpias", "Aleatorio según el espacio disponible"], a: "Unidireccional ('Marcha hacia adelante')", r: "Página 23: El diseño debe seguir el principio de 'marcha hacia adelante' para evitar el cruce de materias primas crudas con productos terminados." },
  { q: "¿Es aceptable guardar ropa o pertenencias personales dentro de la zona de preparación de alimentos?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 18: La ropa de calle y objetos personales deben almacenarse en vestuarios o casilleros fuera de la zona de producción." },
  { q: "¿Qué riesgo presenta el consumo de pescado que ha comenzado su proceso de descomposición en la agalla o agallas de color marrón?", o: ["Desarrollo de bacterias psicrófilas y aminas biógenas", "Ninguno, si se cocina bien", "Exceso de vitamina D"], a: "Desarrollo de bacterias psicrófilas y aminas biógenas", r: "Página 27: Agallas amarillentas o marrones y mal olor son signos de deterioro grave en pescados que impiden su recepción." },
  { q: "¿Cuál es la norma para el uso de toallas de tela para secar utensilios en un restaurante?", o: ["No se deben usar, deben secarse al aire o con papel descartable", "Se pueden usar si se cambian una vez por semana", "Son obligatorias para dar brillo a las copas"], a: "No se deben usar, deben secarse al aire o con papel descartable", r: "Página 22: Los paños de tela acumulan humedad y bacterias, actuando como focos de recontaminación en utensilios." },
  { q: "¿En qué consiste el escaldado o blanqueado térmico de vegetales antes de congelar?", o: ["Tratamiento térmico breve con agua hirviendo o vapor para inactivar enzimas", "Cocción completa en horno por 1 hora", "Sumergir el vegetal en vinagre puro a 0°C"], a: "Tratamiento térmico breve con agua hirviendo o vapor para inactivar enzimas", r: "Página 33: El escaldado frena la acción enzimática en vegetales antes del almacenamiento congelado." },
  { q: "¿Es seguro consumir conservas caseras de hortalizas bajas en acidez si el frasco no hizo 'vacío' al sellar?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 8: La falta de sellado al vacío en conservas de baja acidez favorece el desarrollo de esporas de Clostridium botulinum." },
  { q: "¿Qué se debe verificar en los empaques de harina, arroz o legumbres al momento de recibirlos?", o: ["Que no tengan roturas, gorgojos o signos de humedad", "Solo la marca comercial", "Que el empaque sea transparente"], a: "Que no tengan roturas, gorgojos o signos de humedad", r: "Página 27: Los sacos y envases de secos deben revisarse para comprobar la ausencia de plagas o humedad que deteriore el producto." },
  { q: "¿Qué acción se debe realizar antes de abrir una lata de alimento para su uso?", o: ["Lavar la parte superior de la lata", "Agitarla fuertemente", "Perforarla sin limpiar para que respire"], a: "Lavar la parte superior de la lata", r: "Página 29: La tapa exterior de las latas junta polvo en el almacenamiento y debe limpiarse antes de abrirse para no contaminar el interior." },
  { q: "¿Qué tipo de guantes se recomienda usar cuando se manipulan alimentos directamente tras el lavado de manos?", o: ["Guantes desechables de un solo uso de material apto para alimentos", "Guantes de lana para mantener el calor", "Guantes de jardinería reusables sin lavar"], a: "Guantes desechables de un solo uso de material apto para alimentos", r: "Página 17: Los guantes destinados al contacto con alimentos deben ser de un solo uso, limpios y cambiarse con frecuencia." },
  { q: "¿Qué síntoma provocado por la ingestión de toxinas sintéticas o plaguicidas se manifiesta de manera inmediata?", o: ["Intoxicación química aguda (náuseas, vómitos, mareos a los pocos minutos)", "Triquinosis a las tres semanas", "Brucelosis progresiva a los 6 meses"], a: "Intoxicación química aguda (náuseas, vómitos, mareos a los pocos minutos)", r: "Página 11: La ingestión de contaminantes químicos causa síntomas de intoxicación inmediata a diferencia de muchas infecciones biológicas." },
  { q: "¿Cuál es el riesgo de derramar líquidos dentro de la cámara de congelación?", o: ["Formación de hielo e incrementos de riesgo de caídas y contaminación por escurrimiento", "Reducción automática de la temperatura", "Ninguno, el hielo es esterilizante"], a: "Formación de hielo e incrementos de riesgo de caídas y contaminación por escurrimiento", r: "Página 31: Los derrames dentro de congeladores acumulan escarcha, dificultan el paso y son fuentes de contaminación por succión." },
  { q: "¿Se pueden conservar preparados con cremas pasteleras a temperatura ambiente por más de una hora?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 30: Los rellenos de cremas, lácteos y huevos son de muy alta perecibilidad y deben mantenerse siempre en refrigeración." },
  { q: "¿Qué material debe evitarse en los mangos de cuchillos y utensilios de cocina profesional?", o: ["Madera", "Plástico inyectado", "Acero inoxidable"], a: "Madera", r: "Página 22: La madera absorbe grasa y sangre, astilla y no permite una higienización profunda." },
  { q: "¿Cuál es la forma correcta de descongelar un alimento si se necesita cocinar de inmediato por falta de tiempo?", o: ["En horno microondas en la función descongelar", "Sumergiéndolo en agua hirviendo con sal", "Dejándolo junto al motor de la heladera"], a: "En horno microondas en la función descongelar", r: "Página 35: El microondas es un método aceptado siempre que el alimento pase inmediatamente al proceso de cocción final." },
  { q: "¿Qué microorganismo patógeno puede multiplicarse en rellenos de carne picada cuando no se logra enfriar rápidamente la preparación?", o: ["Clostridium perfringens", "Brucella abortus", "Virus de la Rabia"], a: "Clostridium perfringens", r: "Página 8: Clostridium perfringens proliferan en grandes trozos o recipientes de carne cocida enfriados lentamente." },
  { q: "¿Qué se debe evaluar de las carnes congeladas al recibir al proveedor?", o: ["Que no presenten cristales de hielo grandes ni exudados congelados en el empaque", "Que estén blandas al tacto", "Que el plástico esté húmedo"], a: "Que no presenten cristales de hielo grandes ni exudados congelados en el empaque", r: "Página 27: La presencia de grandes cristales de hielo dentro del paquete indica que el producto sufrió descongelación y recongelación previa." },
  { q: "¿Es permitido el uso de cepillos de cerdas de madera para el lavado de vajilla y utensilios?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 22: Los cepillos con base o cerdas de madera retienen microorganismos y desprenden astillas." },
  { q: "¿Cuál es la función del jabón bactericida en el lavado de manos del manipulador?", o: ["Reducir la flora bacteriana de la piel junto con la remoción mecánica de grasa", "Sustituir el uso de agua", "Dar perfume duradero a los platos"], a: "Reducir la flora bacteriana de la piel junto con la remoción mecánica de grasa", r: "Página 17: El jabón antiséptico remueve la suciedad física y reduce la carga microbiana presente en la piel de las manos." },
  { q: "¿Qué es el 'escamado y eviscerado' en la preparación de pescados?", o: ["La remoción de escamas y vísceras que albergan la mayor carga bacteriana", "Un método de salazón en seco", "El envasado al vacío del producto cocido"], a: "La remoción de escamas y vísceras que albergan la mayor carga bacteriana", r: "Página 33: Las vísceras contienen la flora microbiana del pez, por lo que deben retirarse pronto para evitar la contaminación de la carne." },
  { q: "¿Qué riesgo presenta calentar varias veces un mismo alimento preparado?", o: ["Proliferación de bacterias termorresistentes y pérdida nutricional", "Aumento incontrolado de calorías", "Que cambie el color de los platos"], a: "Proliferación de bacterias termorresistentes y pérdida nutricional", r: "Página 34: Recalentar repetidamente un alimento lo somete en múltiples ocasiones a la zona de peligro térmico." },
  { q: "¿Se puede realizar el fraccionamiento de insumos secos en recipientes sin rotular?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 29: Todo recipiente secundario con materia prima debe llevar etiqueta con nombre, lote y fecha de vencimiento." },
  { q: "¿Qué tipo de bacterias se desarrollan en ambientes con temperaturas moderadas de entre 20°C y 45°C?", o: ["Bacterias mesófilas", "Bacterias psicrófilas", "Bacterias extremófilas de hielo"], a: "Bacterias mesófilas", r: "Página 15: La mayoría de las bacterias patógenas humanas son mesófilas y se multiplican óptimamente alrededor de los 37°C." },
  { q: "¿Qué medida se debe aplicar cuando se detecta excremento de roedores en un depósito?", o: ["Avisar al servicio de control de plagas y descartar alimentos contaminados", "Barrer el excremento y seguir usando el depósito normalmente", "Poner un gato en el depósito"], a: "Avisar al servicio de control de plagas y descartar alimentos contaminados", r: "Página 25: El excremento indica infestación activa; los alimentos expuestos deben desecharse por riesgo de Leptospirosis y Salmonelosis." },
  { q: "¿A qué se le conoce como 'zona limpia' en una cocina o planta de alimentos?", o: ["Al área donde se manipulan alimentos listos para el consumo o ya cocinados", "Al vestuario de empleados", "Al sector donde se junta la basura antes de retirarla"], a: "Al área donde se manipulan alimentos listos para el consumo o ya cocinados", r: "Página 23: La zona limpia comprende aquellos sectores de alta exigencia higiénica sin contacto con materias primas crudas o sucias." },
  { q: "¿Es seguro preparar mayonesas caseras utilizando huevos con la cáscara sucia o fisurada?", o: ["Falso", "Verdadero"], a: "Falso", r: "Página 6: Huevos sucios o rotos tienen una alta probabilidad de introducir Salmonella a las preparaciones sin cocción." },
  { q: "¿Qué alternativa de descongelación de carnes permite un intercambio térmico rápido pero puede causar pérdida de proteínas y vitaminas en la superficie?", o: ["Descongelación con agua", "Descongelación en heladera a 5°C", "Descongelación a temperatura ambiente"], a: "Descongelación con agua", r: "Página 37: La descongelación con agua efectúa el intercambio de temperatura en forma intensa pero puede provocar la pérdida eventual de proteínas, vitaminas y minerales de las capas superficiales." },
  { q: "¿Cuál es el tiempo máximo de conservación recomendado en cámaras de refrigeración para porciones de carne?", o: ["1 día como máximo", "Pocas horas", "1 a 2 semanas"], a: "1 día como máximo", r: "Página 38: El fraccionamiento determina que las porciones se mantengan como máximo 1 día en refrigeración." },
  { q: "¿Cuánto tiempo puede mantenerse la carne molida en la cámara de refrigeración según las pautas de fraccionamiento?", o: ["Pocas horas", "3 días", "1 semana"], a: "Pocas horas", r: "Página 38: El mantenimiento de carne molida en cámaras de refrigeración debe ser de tan solo pocas horas." },
  { q: "¿A qué temperatura mínima deben cocinarse las aves y carnes rellenas para asegurar la eliminación de microorganismos en todas sus partes?", o: ["71 °C", "60 °C", "50 °C"], a: "71 °C", r: "Página 38: Las aves, carnes rellenas y productos con carne deben cocinarse hasta calentar todas las partes a por lo menos 71 °C." },
  { q: "¿A qué temperatura mínima se debe cocinar el cerdo y alimentos que lo contengan?", o: ["74 °C", "63 °C", "68 °C"], a: "74 °C", r: "Página 39: El cerdo y cualquier alimento que lo contenga debe cocinarse a una temperatura no inferior a 74 °C en todas sus partes." },
  { q: "¿Por qué las piezas de carne enrollada (como el matambre) requieren un cuidado especial durante la cocción?", o: ["Porque la superficie externa más contaminada queda atrapada en el centro del rollo", "Porque pierden todo el jugo durante la cocción", "Porque no se pueden cortar adecuadamente"], a: "Porque la superficie externa más contaminada queda atrapada en el centro del rollo", r: "Página 39: La superficie externa y las puntas al enrollarse quedan en el medio, donde las bacterias pueden sobrevivir si no se alcanzan las temperaturas adecuadas." },
  { q: "Si el recalentamiento de platos de carne picada es inevitable, ¿qué temperatura mínima central y tiempo se deben mantener?", o: ["No menos de 74 °C por un mínimo de 2 minutos", "60 °C por 10 minutos", "50 °C por 30 segundos"], a: "No menos de 74 °C por un mínimo de 2 minutos", r: "Páginas 39-40: Si el recalentamiento es inevitable, debe hacerse en su totalidad a no menos de 74 °C y mantenerse así como mínimo 2 minutos." },
  { q: "Al congelar pescado a -18 °C, ¿cuál es el beneficio si fue mantenido previamente en hielo durante 3 días en lugar de 9 días?", o: ["Duplica su tiempo de almacenamiento sin perder cualidades", "Evita que se adhiera al empaque", "Permite cocinarlo sin descongelar"], a: "Duplica su tiempo de almacenamiento sin perder cualidades", r: "Página 40: El pescado congelado tras ser mantenido en hielo por 3 días duplica el tiempo para almacenarse comparado con el preservado en hielo por 9 días." },
  { q: "¿Hasta qué temperatura se puede usar agua corriente para descongelar de forma satisfactoria piezas poco voluminosas de pescado?", o: ["Temperatura no superior a 20 °C", "Agua hirviendo a 100 °C", "Temperatura de 40 °C"], a: "Temperatura no superior a 20 °C", r: "Página 40: Las piezas poco voluminosas de pescado se pueden descongelar en agua corriente a una temperatura no superior a 20 °C." },
  { q: "¿Qué temperatura interna deben alcanzar los filetes de pescado preparadas a la plancha en todas sus partes?", o: ["Por lo menos 60 °C", "Por lo menos 85 °C", "Exactamente 40 °C"], a: "Por lo menos 60 °C", r: "Página 40-41: Los filetes de pescado preparados a la plancha tienen que alcanzar una temperatura de por lo menos 60 °C en todas sus partes." },
  { q: "Tras la cocción de crustáceos como camarones y langostinos, ¿cuál es el tiempo máximo para llevarlos a refrigeración?", o: ["No debe exceder de 4 horas", "Hasta 12 horas", "24 horas"], a: "No debe exceder de 4 horas", r: "Página 41: Posterior a la cocción, el tiempo para llevar crustáceos a refrigeración no debe exceder de 4 horas." },
  { q: "¿Por qué el consumo de moluscos crudos (ostras, almejas, mejillones) representa un alto riesgo sanitario?", o: ["Porque concentran en su organismo contaminantes marinos, bacterias como el Cólera y toxinas de algas", "Porque contienen excesiva sal", "Porque destruyen la flora intestinal"], a: "Porque concentran en su organismo contaminantes marinos, bacterias como el Cólera y toxinas de algas", r: "Página 40: Los moluscos concentran en su organismo contaminantes presentes en el medio marino como la bacteria del cólera o toxinas de algas." },
  { q: "En la desinfección de hortalizas con lavandina, ¿cuál es la concentración y tiempo de contacto recomendados?", o: ["100 a 200 ppm por 15 minutos (1 cucharada en 5 litros de agua)", "500 ppm por 1 hora", "10 ppm por 30 segundos"], a: "100 a 200 ppm por 15 minutos (1 cucharada en 5 litros de agua)", r: "Página 42: Se utiliza lavandina en soluciones de 100 a 200 ppm por un tiempo de contacto de 15 minutos (1 cucharada por 5 litros de agua)." },
  { q: "¿Qué sucede si se deja actuar la lavandina sobre las hortalizas por más tiempo del recomendado (más de 15 min)?", o: ["Causa marchitamiento y gusto a lavandina", "Mejora la nutrición del vegetal", "Hace que el vegetal cambie a color azul"], a: "Causa marchitamiento y gusto a lavandina", r: "Página 42: Dar un tiempo de contacto más largo causa marchitamiento de la hortaliza y un gusto a lavandina." },
  { q: "¿Qué precaución previa se exige con los recipientes en los cuales se trasladan las hortalizas desinfectadas?", o: ["Han de ser previamente desinfectados", "Deben ser únicamente de madera", "Tienen que estar cubiertos de papel periódico"], a: "Han de ser previamente desinfectados", r: "Página 42: Como requisito, los recipientes en los cuales se trasladen las hortalizas han de ser previamente desinfectados." },
  { q: "En repostería, ¿qué medida de higiene es indispensable con las mangas y boquillas tras su uso?", o: ["Lavarlas cuidadosamente y desinfectarlas después de cada uso", "Guardarlas directamente en la heladera", "Secarlas solo con un paño seco"], a: "Lavarlas cuidadosamente y desinfectarlas después de cada uso", r: "Página 43: Si las mangas y boquillas no son lavadas cuidadosamente y desinfectadas después de cada uso, significan un riesgo importante de contaminación." },
  { q: "¿Por qué se desaconseja la preparación de mayonesas caseras en los establecimientos de comidas?", o: ["Por el riesgo de utilizar huevo crudo contaminado con Salmonella", "Porque requieren demasiado aceite", "Porque se cortan muy rápido al enfriar"], a: "Por el riesgo de utilizar huevo crudo contaminado con Salmonella", r: "Página 44: En ningún caso debemos usar huevo crudo por contaminación con Salmonella, por lo que no es recomendable preparar mayonesas caseras." },
  { q: "¿Por qué los recipientes plásticos profundos son inaceptables para el enfriamiento rápido de alimentos?", o: ["Reducen la eficiencia de penetración del frío e impiden un enfriamiento adecuado", "Se rompen con el frío extremo", "Absorben el aroma del refrigerador"], a: "Reducen la eficiencia de penetración del frío e impiden un enfriamiento adecuado", r: "Página 44-45: Recipientes de mucha profundidad o de plástico reducen de manera considerable la eficiencia del enfriamiento." },
  { q: "En la primera etapa del enfriamiento rápido de alimentos cocinados a más de 60 °C, ¿en cuánto tiempo debe descender la temperatura a 21 °C?", o: ["En 2 horas o menos", "En 30 minutos", "En 6 horas"], a: "En 2 horas o menos", r: "Página 44: La primera etapa exige reducir la temperatura desde 60 °C o más hasta 21 °C en 2 horas o menos." },
  { q: "¿Cuál es el tiempo total máximo estipulado para completar todo el proceso de enfriamiento rápido (desde 60 °C o más hasta 5 °C o menos)?", o: ["4 horas máximo", "8 horas", "12 horas"], a: "4 horas máximo", r: "Página 44: El proceso total debe sumar un máximo de 4 horas (2 horas para bajar a 21°C y 2 horas adicionales para llegar a 5°C o menos)." },
  { q: "Para alimentos que salen de cocción a temperaturas muy altas (más de 75 °C), ¿cuánto debe durar la etapa de pre-enfriamiento al ambiente (hasta 60 °C)?", o: ["Un tiempo inferior a 30 minutos", "Al menos 2 horas", "Toda la noche"], a: "Un tiempo inferior a 30 minutos", r: "Página 45: La etapa de pre-enfriamiento busca descender la temperatura desde 75 °C o más hasta 60 °C en un tiempo inferior a 30 minutos." },
  { q: "¿De qué materiales se recomienda que sean los recipientes para lograr un enfriamiento rápido eficiente y cuál debe ser su profundidad máxima inicial?", o: ["Acero inoxidable o aluminio, con no más de 5 a 6 cm de profundidad", "Plástico grueso, con 20 cm de profundidad", "Vidrio templado, de 15 cm de profundidad"], a: "Acero inoxidable o aluminio, con no más de 5 a 6 cm de profundidad", r: "Página 45: Los recipientes deberían tener no más de 5 o 6 cm de profundidad y el material de elección debería ser acero inoxidable o aluminio." },
  { q: "Al enfriar sopas, cremas o preparaciones líquidas en la heladera, ¿qué profundidad límite no debe sobrepasar el alimento en el recipiente?", o: ["7 u 8 centímetros", "15 centímetros", "2 centímetros"], a: "7 u 8 centímetros", r: "Página 46: Alimentos como sopas o cremas no deben sobrepasar el nivel de 7 u 8 centímetros de profundidad." },
  { q: "Durante el enfriamiento rápido en recipientes sobre hielo, ¿con qué frecuencia se debe revolver el alimento?", o: ["Cada 15 minutos", "Cada 2 horas", "Una sola vez al final"], a: "Cada 15 minutos", r: "Página 45: Revolver con frecuencia (cada 15 minutos) los alimentos dentro del recipiente ayuda a que el enfriamiento sea uniforme." },
  { q: "Si no se logran las temperaturas y tiempos requeridos en el enfriamiento rápido, ¿cuál es una medida correctiva permitida si el servido es en breve?", o: ["Recalentamiento rápido del alimento a 75 °C dentro de las 2 horas siguientes", "Agregarle hielo directamente al alimento", "Dejarlo afuera hasta el día siguiente"], a: "Recalentamiento rápido del alimento a 75 °C dentro de las 2 horas siguientes", r: "Página 46: Se puede decidir el recalentamiento rápido del alimento a 75 °C dentro de las 2 horas siguientes o descartarlo." },
  { q: "¿Qué información obligatoria debe marcarse en los recipientes de alimentos enfriados antes de almacenarlos?", o: ["Fecha y tiempo en que fueron preparados (fecha de vencimiento/descarte)", "Nombre del cocinero únicamente", "El precio del plato"], a: "Fecha y tiempo en que fueron preparados (fecha de vencimiento/descarte)", r: "Página 46: Los alimentos enfriados deberán ser marcados con la fecha y tiempo en que fueron preparados para indicar su fecha de vencimiento o descarte." },
  { q: "Según las 'Claves de la Inocuidad', ¿por qué los trapos de limpieza, esponjas y manos sin lavar son peligrosos?", o: ["Porque transportan bacterias peligrosas provenientes de la tierra, agua, animales y personas", "Porque rallan la superficie de los equipos", "Porque consumen demasiado detergente"], a: "Porque transportan bacterias peligrosas provenientes de la tierra, agua, animales y personas", r: "Página 47: En la tierra, agua, animales y personas hay bacterias peligrosas que son transportadas por manos, ropa, trapos y esponjas." },
  { q: "De acuerdo con la Clave 2 de inocuidad ('Separe lo crudo de lo cocido'), ¿por qué los jugos de carnes crudas son riesgosos?", o: ["Pueden contener bacterias peligrosas que se transfieren a alimentos listos para consumir", "Hacen que las verduras pierdan su color verde", "Dificultan la limpieza con lavandina"], a: "Pueden contener bacterias peligrosas que se transfieren a alimentos listos para consumir", r: "Página 48: Los jugos de carnes, pollos y pescados crudos contienen bacterias peligrosas que pueden transferirse a comidas listas para consumir." },
  { q: "¿A qué temperatura se garantiza que la correcta cocción de la mayoría de los alimentos mata las bacterias peligrosas?", o: ["Alcanzando 70 °C en todas sus partes", "Alcanzando 40 °C", "Hirviendo a 120 °C bajo presión"], a: "Alcanzando 70 °C en todas sus partes", r: "Página 49: Cocinar el alimento de modo que todas las partes alcancen 70 °C garantiza la inocuidad matando las bacterias peligrosas." },
  { q: "En preparaciones a base de carne picada o molida, ¿qué indicador visual básico demuestra que la cocción no ha sido suficiente?", o: ["Partes rojas o rosadas en el interior", "Presencia de vapores", "Capa dorada exterior"], a: "Partes rojas o rosadas en el interior", r: "Página 49: Para alimentos a base de carne picada, hay que cuidar que no queden partes rojas en el interior." },
  { q: "¿Cuál es el riesgo de descongelar piezas muy voluminosas de carne en microondas si no se completa adecuadamente el proceso?", o: ["Que el calor en la cocción posterior no penetre al centro y sobrevivan bacterias", "Que la carne pierda todo su sabor original", "Que el plato gire demasiado rápido"], a: "Que el calor en la cocción posterior no penetre al centro y sobrevivan bacterias", r: "Página 37: Si el descongelamiento en microondas de piezas voluminosas no es completo, el calor de cocción no penetrará totalmente y sobrevivirán bacterias en el centro." },
  { q: "¿Cuál es la norma respecto al fraccionamiento de carne cruda y cocida con los mismos elementos de corte?", o: ["Debe evitarse absolutamente sin antes realizar limpieza y desinfección exhaustiva", "Se permite si se usa una servilleta para limpiar la cuchilla entre cortes", "Solo se permite en horarios de alto trabajo"], a: "Debe evitarse absolutamente sin antes realizar limpieza y desinfección exhaustiva", r: "Página 38: Es importante evitar el fraccionamiento de productos crudos y cocidos con el mismo elemento sin previa limpieza y desinfección." },
  { q: "¿Por qué los cortes de carne de mayor tamaño (como cuartos de canal) duran más días en refrigeración que las porciones pequeñas?", o: ["Porque exponen menor superficie al aire y menor liberación de jugos nutritivos", "Porque tienen más grasa protectora", "Porque están a menor temperatura"], a: "Porque exponen menor superficie al aire y menor liberación de jugos nutritivos", r: "Página 38: El fraccionamiento aumenta la superficie expuesta y libera jugos con nutrientes, acelerando la proliferación microbiana en porciones chicas." },
  { q: "Durante la preparación de bandejas de carnes frías o calientes, ¿qué variables deben ser estrictamente controladas?", o: ["La temperatura de las carnes, el tiempo al ambiente y la contaminación cruzada", "Únicamente el peso exacto de la ración", "El tipo de decoración usado en la bandeja"], a: "La temperatura de las carnes, el tiempo al ambiente y la contaminación cruzada", r: "Página 39: Hay que controlar de manera estricta la temperatura de las carnes, el tiempo al ambiente y las posibilidades de contaminación cruzada." },
  { q: "¿Por qué las salsas elaboradas a base de trozos o jugos de carne son consideradas de alto riesgo microbiano en la cocina?", o: ["Por su elevado contenido de nutrientes que favorece el desarrollo bacteriano", "Porque contienen demasiada sal", "Porque no se pueden refrigerar"], a: "Por su elevado contenido de nutrientes que favorece el desarrollo bacteriano", r: "Página 39: Las salsas por su alto contenido de nutrientes representan una fuente de contaminación importante si no se manejan adecuadamente." },
  { q: "¿Qué alternativa industrial reduce la contaminación bacteriana asociada a la elaboración de salsas cárnicas caseras?", o: ["El uso de concentrados de carne comerciales de calidad", "Agregar más vinagre a las salsas caseras", "Dejar hervir las salsas todo el día a fuego bajo"], a: "El uso de concentrados de carne comerciales de calidad", r: "Página 39: Una alternativa es conseguir en el mercado concentrados de carne para reemplazar las salsas, reduciendo la contaminación." },
  { q: "¿Cuál es la regla sobre la preparación y servido de platos que contengan carnes picadas?", o: ["Deben prepararse y consumirse el mismo día", "Se pueden guardar en la heladera hasta por una semana", "Pueden dejarse a temperatura ambiente si están tapados"], a: "Deben prepararse y consumirse el mismo día", r: "Página 39: Debe respetarse sin excepción la norma de que los platos de carnes picadas se preparen y consuman el mismo día." },
  { q: "En el almacenamiento de productos lácteos como la manteca y quesos, ¿cuál es el factor clave para mantener su seguridad?", o: ["Selección adecuada de proveedor, temperatura y rotación desde su ingreso", "Dejarlos reposar al aire libre antes de guardarlos", "Lavarlos con agua potable todos los días"], a: "Selección adecuada de proveedor, temperatura y rotación desde su ingreso", r: "Página 42: Si son adecuadamente seleccionados y manejados en temperatura y rotación desde su ingreso, no significan mayor riesgo." },
  { q: "¿Qué tipo de bacterias se intentan prevenir principalmente con el lavado minucioso de cáscara de huevo antes de usarlos en repostería?", o: ["Salmonella", "Escherichia coli", "Listeria monocytogenes"], a: "Salmonella", r: "Página 43: Los huevos empleados en repostería deben lavarse por cuanto son una fuente de contaminación por Salmonella." },
  { q: "¿Por qué se consideran de bajo riesgo las frutas enlatadas utilizadas para decoración o relleno en pastelería?", o: ["Debido al proceso de elaboración e higienización industrial que reciben", "Porque contienen conservantes sintéticos letales", "Porque no contienen azúcar libre"], a: "Debido al proceso de elaboración e higienización industrial que reciben", r: "Página 43: Algunos enlatados de fruta son de bajo riesgo debido a su proceso de elaboración industrial." },
  { q: "Cuando no se cuenta con agua potable de red segura en el establecimiento, ¿cuál es una alternativa confiable?", o: ["Utilizar agua tratada y embotellada de empresas reconocidas", "Usar agua de pozo directo sin filtrar", "Hervir el agua únicamente 5 segundos"], a: "Utilizar agua tratada y embotellada de empresas reconocidas", r: "Página 43: Las aguas tratadas y embotelladas son una alternativa confiable cuando el agua de la red carece de controles." },
  { q: "¿Qué tratamiento simple en el hogar o cocina permite potabilizar el agua de red si hay dudas sobre su calidad?", o: ["Hervir durante 5 minutos o agregar 2 gotas de lavandina por litro y reposar 30 minutos", "Filtrarla únicamente con un paño de tela", "Mezclar el agua con jugo de limón puro"], a: "Hervir durante 5 minutos o agregar 2 gotas de lavandina por litro y reposar 30 minutos", r: "Página 43 (diagrama): Para potabilizar se debe hervir 5 minutos o agregar 2 gotas de lavandina por litro de agua dejando reposar 30 minutos." },
  { q: "Respecto al manejo del hielo en cubos o escamas en el servicio de comidas, ¿cómo debe ser considerado?", o: ["Como un alimento más que requiere cuidado de higiene y recipientes limpios", "Como un elemento químico inerte de riesgo nulo", "Como un desinfectante natural por su baja temperatura"], a: "Como un alimento más que requiere cuidado de higiene y recipientes limpios", r: "Página 44: El hielo debe ser manipulado con mucho cuidado, teniendo en cuenta que es un alimento también." },
  { q: "Para ensaladas y aderezos que contienen lácteos o derivados de huevo, ¿dónde deben mantenerse durante el servicio?", o: ["Fuera de la zona de temperaturas de peligro (en refrigeración adecuada)", "A temperatura ambiente para mantener la textura", "Cerca de las hornallas para servir tibio"], a: "Fuera de la zona de temperaturas de peligro (en refrigeración adecuada)", r: "Página 44: Los aderezos y alimentos que contienen huevo o leche es necesario mantenerlos fuera de la zona de peligro." },
  { q: "¿Qué efecto tiene tapar completamente un recipiente de comida caliente al momento de intentar enfriarlo rápidamente?", o: ["Dificulta la circulación del aire frío y vuelve el enfriamiento mucho más lento", "Acelera el proceso de congelación", "Elimina los vapores de bacterias"], a: "Dificulta la circulación del aire frío y vuelve el enfriamiento mucho más lento", r: "Página 44-46: Los recipientes cubiertos impiden la buena circulación del aire frío, haciendo que el enfriamiento sea más lento." },
  { q: "Durante el enfriamiento de piezas grandes de carne recién cocinadas, ¿qué acción inicial facilita el descenso térmico?", o: ["Dividir en porciones pequeñas y fraccionar grandes partidas", "Dejar la pieza entera en una bandeja de plástico", "Sumergir la carne directamente en agua helada sin envolver"], a: "Dividir en porciones pequeñas y fraccionar grandes partidas", r: "Página 45: El primer paso es dividir en porciones pequeñas las piezas grandes y fraccionar partidas voluminosas." },
  { q: "¿Cómo deben acomodarse las porciones de alimentos calientes dentro de las fuentes para enfriar?", o: ["Distribuidas con espacio entre sí evitando la acumulación en el centro", "Apiladas una sobre otra en el centro del recipiente", "Aplastadas contra las paredes laterales sin dejar aire"], a: "Distribuidas con espacio entre sí evitando la acumulación en el centro", r: "Página 45: La distribución de las porciones siempre se hará evitando su acumulación en el centro del recipiente." },
  { q: "En caso de usar una cámara de congelación para enfriar rápidamente un preparado caliente, ¿cuál es la condición necesaria?", o: ["Que no haya otros alimentos congelados y no se superen las 4 horas totales", "Que la cámara se mantenga apagada durante la primera hora", "Que el alimento contenga únicamente sal"], a: "Que no haya otros alimentos congelados y no se superen las 4 horas totales", r: "Página 46: Puede realizarse en un congelador donde no haya alimentos congelados siempre que no se sobrepasen las 4 horas totales." },
  { q: "¿Por qué es obligatorio lavarse las manos frecuentemente DURANTE la preparación de alimentos y no solo al inicio?", o: ["Porque se manipulan diferentes insumos y utensilios que pueden recontaminar las manos", "Para mantener la piel hidratada", "Para no manchar los platos con grasa"], a: "Porque se manipulan diferentes insumos y utensilios que pueden recontaminar las manos", r: "Página 47: Las manos transportan bacterias de un elemento a otro a lo largo de la preparación si no se lavan a menudo." },
  { q: "¿Qué medida preventiva de higiene básica evita la entrada de insectos y plagas a la zona de cocina?", o: ["Evitar el contacto de alimentos y áreas de cocina con animales y mascotas", "Mantener luces encendidas las 24 horas", "Usar insecticidas en aerosol sobre los platos"], a: "Evitar el contacto de alimentos y áreas de cocina con animales y mascotas", r: "Página 47: Evite el contacto de alimentos y áreas de cocina con insectos, mascotas y otros animales." },
  { q: "Según la clave 'Separe los alimentos crudos de los cocidos', ¿qué se debe hacer con la tabla de picar tras cortar pollo crudo?", o: ["Lavar y desinfectar la superficie y el cuchillo antes de cortar alimentos cocidos o listos", "Pasarle un paño seco para retirar el jugo sobrante", "Usar el otro lado de la misma tabla sin lavar"], a: "Lavar y desinfectar la superficie y el cuchillo antes de cortar alimentos cocidos o listos", r: "Página 48: Limpie las superficies y utensilios entre la manipulación de carnes crudas y comidas listas para consumo." },
  { q: "¿Cómo se debe garantizar que un guiso o sopa caliente haya alcanzado una temperatura segura durante la cocción?", o: ["Hirviendo la preparación para asegurar que alcanzó al menos 70 °C", "Probando el sabor con una cuchara de madera", "Esperando a que cambie de color en la superficie"], a: "Hirviendo la preparación para asegurar que alcanzó al menos 70 °C", r: "Página 49: Hierva los alimentos como sopas y guisos para asegurarse de que alcanzaron los 70 °C." },
  { q: "¿Por qué la carne en trozos grandes o pavos enteros requieren un control más estricto de la temperatura de cocción?", o: ["Porque el calor tarda más tiempo en penetrar hasta el centro del alimento", "Porque se queman muy rápido por fuera", "Porque pierden su peso original al cocinarse"], a: "Porque el calor tarda más tiempo en penetrar hasta el centro del alimento", r: "Página 49: Existen alimentos como trozos grandes de carne o pollos enteros que requieren especial control de cocción para calentar el centro." },
  { q: "¿Qué recomendación específica se da respecto a las hojas exteriores de las verduras de hoja verde (como lechuga o acelga)?", o: ["Deben eliminarse tras el lavado inicial por concentrar la mayor suciedad", "Se deben cocinar aparte para hacer caldos", "Deben dejarse para proteger las hojas internas"], a: "Deben eliminarse tras el lavado inicial por concentrar la mayor suciedad", r: "Página 42: En verduras de hoja, el lavado precede a la eliminación de hojas externas que contienen la mayor carga de suciedad." },
  { q: "Para evitar la contaminación cruzada en carnes embutidas o cocidas ya compradas, ¿qué cuidado se aplica al cortarlas?", o: ["No usar rebanadoras ni cuchillos con los que se haya cortado carne cruda previa", "Untar la rebanadora con aceite vegetal antes de usarla", "Cortarlas únicamente a temperatura ambiente"], a: "No usar rebanadoras ni cuchillos con los que se haya cortado carne cruda previa", r: "Página 39: En el fraccionamiento de embutidos pueden contaminarse si se usan equipos o utensilios que manipularon carne cruda." },
  { q: "¿Cuál es el beneficio de agitar o revolver periódicamente el hielo que rodea los recipientes en un baño de enfriamiento?", o: ["Mejora la transferencia térmica y hace más eficiente el enfriamiento", "Evita que el hielo se derrita", "Previene la aparición de malos olores"], a: "Mejora la transferencia térmica y hace más eficiente el enfriamiento", r: "Página 45: Revolver también el hielo que rodea los recipientes ayuda a la eficiencia del proceso de enfriamiento." },
  { q: "¿A qué temperatura de cocción se asegura la eliminación de posibles parásitos o toxinas en productos de la pesca fritos o a la plancha?", o: ["Alcanzando por lo menos 60 °C en el centro térmico de la pieza", "Llegando a 40 °C", "Con solo dorar la parte exterior"], a: "Alcanzando por lo menos 60 °C en el centro térmico de la pieza", r: "Página 40-41: Tienen que alcanzar una temperatura de por lo menos 60 °C en todas sus partes." },
  { q: "¿Cuál es la norma referente al almacenamiento de productos químicos o plaguicidas respecto a frutas y hortalizas?", o: ["Deben mantenerse totalmente separados para evitar contaminación química", "Se pueden guardar en la misma repisa si están cerrados", "Se deben aplicar sobre la verdura antes del lavado"], a: "Deben mantenerse totalmente separados para evitar contaminación química", r: "Páginas 11 y 41: El uso o presencia de químicos/plaguicidas exige estricta separación para evitar intoxicaciones en alimentos de huerta." },
  { q: "¿Qué precaución se debe tener con los rellenos de tartas hechos a base de huevo o crema al ser enfriados?", o: ["Evitar colocarlos en recipientes plásticos profundos para permitir el enfriamiento rápido", "Dejarlos toda la noche sobre la mesa de trabajo", "Mezclarlos con carne cruda antes de enfriar"], a: "Evitar colocarlos en recipientes plásticos profundos para permitir el enfriamiento rápido", r: "Página 44: Los recipientes profundos o de plástico son inaceptables para el enfriamiento rápido de alimentos potencialmente peligrosos." },
  { q: "¿Cuál es el principio fundamental que rige el recalentamiento de comidas preparadas el día anterior?", o: ["Alcanzar rápidamente los 74 °C o 70 °C en todo el alimento según su tipo", "Calentar suavemente hasta que esté tibio al tacto", "Agregarle agua hirviendo por encima sin mezclar"], a: "Alcanzar rápidamente los 74 °C o 70 °C en todo el alimento según su tipo", r: "Páginas 39 y 49: El recalentamiento debe asegurar que la comida alcance temperaturas de seguridad (70 °C a 74 °C) en su totalidad." },
  { q: "Al descongelar carne en la heladera a temperaturas de 0 a 5 °C, ¿qué inconveniente surge al procesar trozos muy grandes?", o: ["Tiempos de descongelado muy prolongados que resultan antieconómicos y aumentan bacterias", "Pérdida total del color rojo característico", "Congelación de los jugos periféricos"], a: "Tiempos de descongelado muy prolongados que resultan antieconómicos y aumentan bacterias", r: "Página 37: Para trozos grandes, los tiempos muy prolongados de descongelado pueden resultar antieconómicos y generar un marcado aumento microbiano." },
  { q: "¿Por qué es recomendable realizar el proceso de descongelación partiendo de piezas pequeñas de carne?", o: ["Porque el proceso resulta más eficiente y rápido", "Porque no requieren almacenamiento previo", "Porque evita el uso de envoltorios plásticos"], a: "Porque el proceso resulta más eficiente y rápido", r: "Página 37: Es recomendable realizar el proceso partiendo de piezas pequeñas, lo cual resulta más eficiente." },
  { q: "Al utilizar agua para descongelar carne, ¿cómo se evita la contaminación cruzada si se colocan varios trozos en el mismo recipiente?", o: ["Envolviendo las carnes en envases de plástico hermético", "Añadiendo sal gruesa al agua", "Cambiando el agua cada 5 minutos"], a: "Envolviendo las carnes en envases de plástico hermético", r: "Página 37: La contaminación cruzada en agua se puede evitar cuando las carnes están envueltas en envases de plástico hermético." },
  { q: "Durante el fraccionamiento de la carne, ¿cuál de los siguientes es un efecto inevitable que favorece el crecimiento bacteriano?", o: ["Se liberan líquidos ricos en nutrientes", "Aumenta la densidad del tejido muscular", "Disminuye la absorción de humedad ambiental"], a: "Se liberan líquidos ricos en nutrientes", r: "Página 38: El fraccionamiento trae como efecto la liberación de líquidos ricos en nutrientes, lo que favorece la proliferación microbiana." },
  { q: "¿Cuál es el tiempo máximo recomendado de mantenimiento en cámara de refrigeración para los cortes especiales de carne?", o: ["1 a 2 días", "Pocas horas", "Hasta 10 días"], a: "1 a 2 días", r: "Página 38: El fraccionamiento determina que la duración para cortes especiales sea de 1 a 2 días." },
  { q: "¿Qué tiempo máximo de conservación en refrigeración se indica para cuartos de canal, cortes y semicortes de carne?", o: ["Pocos días", "Un mes completo", "Máximo 12 horas"], a: "Pocos días", r: "Página 38: El mantenimiento para cuartos de canal, cortes y semicortes en cámaras de refrigeración es de pocos días." },
  { q: "En la preparación de cortes de carne, ¿qué acción inmediata debe realizarse tras el fraccionamiento antes de llevarlas a la heladera?", o: ["Eliminar los jugos formados para lograr superficies lo más secas posible", "Sazonar con abundante sal marina", "Lavar la superficie con agua tibia"], a: "Eliminar los jugos formados para lograr superficies lo más secas posible", r: "Página 38: En la preparación de cortes se eliminarán los jugos formados para lograr superficies lo más secas e inmediatamente llevar a la heladera." },
  { q: "¿Por qué es fundamental vigilar la temperatura a intervalos en cocciones de carne que demoran más de una hora?", o: ["Porque cabe la posibilidad de mantener los alimentos largo tiempo en temperaturas críticas", "Para evitar que la carne pierda su forma", "Para reducir el tiempo total de horneado a la mitad"], a: "Porque cabe la posibilidad de mantener los alimentos largo tiempo en temperaturas críticas", r: "Página 39: La vigilancia es fundamental en cocciones de más de una hora cuando cabe la posibilidad de mantener los alimentos largo tiempo en temperaturas críticas." },
  { q: "¿Por qué no debe utilizarse la práctica de rebanar grandes piezas de carne o ave tras refrigerarlas para dejarlas a temperatura ambiente antes de calentar?", o: ["Porque prolonga el tiempo en que la carne permanece a temperaturas óptimas para multiplicación bacteriana", "Porque altera el color del corte", "Porque el rebanado destruye las fibras cárnicas"], a: "Porque prolonga el timepo en que la carne permanece a temperaturas óptimas para multiplicación bacteriana", r: "Página 39: Esta práctica no debe utilizarse ya que prolonga el tiempo en el cual la carne permanece a temperaturas óptimas para la multiplicación de bacterias." },
  { q: "Al recalentar carne rebanada previamente cocinada, ¿qué instrumento es preciso usar para comprobar que se alcanzaron los 74 °C en el centro?", o: ["Termómetro de hincado o penetración", "Reloj de cocina", "Análisis visual de la grasa externa"], a: "Termómetro de hincado o penetración", r: "Página 39: El recalentamiento se hará hasta que alcance una temperatura no inferior a 74 °C en el centro de la masa, comprobándolo con el uso de termómetros." },
  { q: "¿Cuál es la principal preocupación en el control de calidad microbiológico del pescado fresco en cocina?", o: ["La posibilidad de presentar alteraciones que lo hagan inadecuado para el consumo", "Su contenido de espinas", "La pérdida de su firmeza al freír"], a: "La posibilidad de presentar alteraciones que lo hagan inadecuado para el consumo", r: "Página 40: La principal preocupación del control de calidad microbiológico del pescado se refiere a la posibilidad de presentar alteraciones que lo hagan inadecuado." },
  { q: "¿Cuál es la temperatura ideal recomendada para el almacenamiento de pescados y mariscos por congelación en planta?", o: ["-18 °C", "0 °C", "-5 °C"], a: "-18 °C", r: "Página 40: El almacenamiento por congelación a temperatura de -18 °C brinda mejores resultados para estos productos." },
  { q: "Durante la recepción e ingreso de pescados a la planta, ¿qué evaluación sensorial inicial adquiere suma importancia?", o: ["Identificar las características de olor, textura y color deseables del producto fresco", "Medir el peso exacto de las agallas", "Comprobar la salinidad de la piel"], a: "Identificar las características de olor, textura y color deseables del producto fresco", r: "Página 40: Adquiere suma importancia la evaluación para identificar las características de olor, textura y color deseables del producto fresco." },
  { q: "En la operación de fileteo de pescado, ¿cuál es el factor primordial para evitar la contaminación cruzada?", o: ["Higiene de operarios y correcta desinfección de cuchillos, superficies y equipos", "Uso de guantes de tela de algodón", "Lavar el pescado con detergente suave"], a: "Higiene de operarios y correcta desinfección de cuchillos, superficies y equipos", r: "Página 40: La higiene de los operarios y la correcta desinfección de cuchillos, superficies y equipos tienen una repercusión evidente para evitar contaminación cruzada." },
  { q: "Tras pelar o retirar partes no comestibles a crustáceos cocidos (camarones/langostinos), ¿qué condición de tiempo se requiere?", o: ["Un tiempo lo suficientemente corto como para conservar la temperatura de refrigeración", "Esperar 2 horas a temperatura ambiente para secado", "Sumergirlos en vinagre por 30 minutos"], a: "Un tiempo lo suficientemente corto como para conservar la temperatura de refrigeración", r: "Página 41: Retirar partes no comestibles exige un tiempo lo suficientemente corto como para conservar la temperatura de refrigeración." },
  { q: "¿A qué se debe principalmente la carga inicial de bacterias presentes en frutas y hortalizas?", o: ["Al suelo, agua, aire o insectos según el tipo de cultivo", "A la luz solar directa", "Al empaque de cartón de transporte"], a: "Al suelo, agua, aire o insectos según el tipo de cultivo", r: "Página 41: Pueden ser portadores de una gran carga inicial adquirida en el suelo, el agua, el aire o por medio de insectos." },
  { q: "¿Por qué las hortalizas de hoja tienen un perfil de exposición diferente respecto a las hortalizas de raíz?", o: ["Las hojas tienen mayor exposición al aire y las raíces mayor contacto con el suelo", "Las raíces no contienen bacterias", "Las hojas absorben más plaguicidas que las raíces"], a: "Las hojas tienen mayor exposición al aire y las raíces mayor contacto con el suelo", r: "Página 41: Las hojas tienen una mayor exposición al aire, mientras las raíces tienen un mayor contacto con el suelo." },
  { q: "¿Qué práctica agrícola es la mayor responsable en términos de salud pública de transmitir virus como la Hepatitis a través de hortalizas?", o: ["La introducción de materias fecales en el agua de riego o en el suelo", "El uso excesivo de fertilizantes sintéticos", "La recolección mecanizada tardía"], a: "La introducción de materias fecales en el agua de riego o en el suelo", r: "Página 41: Lo que más preocupa es la introducción de materias fecales en el agua de riego o en el suelo por riesgo de bacterias, parásitos y virus como la hepatitis." },
  { q: "En el lavado de verduras de hoja, ¿cómo debe ser el chorro de agua utilizado antes de su desinfección?", o: ["Agua potable a chorro en forma abundante", "Agua tibia estancada en recipiente", "Agua con sal en spray"], a: "Agua potable a chorro en forma abundante", r: "Página 42: El lavado se hará con agua potable a chorro en forma abundante para procurar su limpieza profunda." },
  { q: "Tras sumergir los vegetales en solución desinfectante de lavandina por 15 minutos, ¿qué paso es indispensable realizar?", o: ["Un enjuague enérgico con agua potable", "Dejarlos secar al sol directo", "Frotarlos con un paño seco"], a: "Un enjuague enérgico con agua potable", r: "Página 42: Luego de la inmersión de 15 minutos en lavandina es necesario realizar un enjuague enérgico." },
  { q: "¿Por qué la leche es considerada un alimento extremadamente susceptible a la contaminación bacteriana?", o: ["Porque su composición reúne excelentes condiciones para la multiplicación de la mayoría de bacterias", "Porque no se puede refrigerar inmediatamente", "Porque se evapora a temperatura ambiente"], a: "Porque su composición reúne excelentes condiciones para la multiplicación de la mayoría de bacterias", r: "Página 42: Como la composición de la leche reúne excelentes condiciones para la multiplicación bacteriana, es muy susceptible." },
  { q: "¿Qué ingredientes de productos de repostería requieren condiciones más estrictas de higiene por su sensibilidad?", o: ["Crema de leche, mayonesa, huevos y frutas", "Harina de trigo y azúcar refinada", "Esencias artificiales y colorantes"], a: "Crema de leche, mayonesa, huevos y frutas", r: "Página 42-43: Los productos de repostería incluyen ingredientes sensibles como crema de leche, mayonesa, huevos y frutas." },
  { q: "En la elaboración de pasteles y empanadas que contienen carne molida, ¿cuáles son los puntos críticos a controlar con especial rigor?", o: ["Tiempos de cocción, conservación en caliente o frío y recalentamiento", "El grosor de la masa exterior", "El tipo de horno utilizado"], a: "Tiempos de cocción, conservación en caliente o frío y recalentamiento", r: "Página 43: Los tiempos de cocción, su conservación en caliente o frío y el recalentamiento son los puntos críticos a controlar con especial rigor." },
  { q: "¿Qué tratamiento preventivo se debe aplicar a las frutas frescas que se utilizan como adorno en repostería?", o: ["Ser lavadas y desinfectadas previamente", "Sumergirlas en almíbar hirviendo", "Pelarlas completamente sin lavar"], a: "Ser lavadas y desinfectadas previamente", r: "Página 43: Las frutas frescas que se usan como adorno tienen mayor riesgo de contaminación, por lo que deben ser lavadas y desinfectadas." },
  { q: "¿Qué características deben tener las empresas proveedoras de agua embotellada para los servicios de comida?", o: ["Ser empresas de reconocida prestancia en la localidad", "Ser distribuidores internacionales exclusivamente", "Vender únicamente en recipientes de vidrio"], a: "Ser empresas de reconocida prestancia en la localidad", r: "Página 43: Será necesario asegurarse que los proveedores de aguas embotelladas sean empresas de reconocida prestancia en la localidad." },
  { q: "En el procedimiento de enfriamiento rápido, ¿cuántas etapas formales se definen para bajar la temperatura de 60 °C a 5 °C o menos?", o: ["Dos etapas consecutivas (de 60 °C a 21 °C y de 21 °C a 5 °C)", "Tres etapas de 1 hora cada una", "Una sola etapa directa de congelación"], a: "Dos etapas consecutivas (de 60 °C a 21 °C y de 21 °C a 5 °C)", r: "Página 44: Los procedimientos de enfriamiento rápido deberían hacerse en 2 etapas: de 60 °C a 21 °C y de 21 °C a 5 °C o menos." },
  { q: "¿Dónde debe realizarse la etapa de pre-enfriamiento en reposo para alimentos salidos de cocción a más de 75 °C?", o: ["En un área bien ventilada que permita la disipación del calor", "Dentro de la cámara de congelación cerrada", "Cerca de las áreas de recepción de materia prima"], a: "En un área bien ventilada que permita la disipación del calor", r: "Página 45: El pre-enfriamiento al ambiente se debe hacer en un área bien ventilada que permita la disipación del calor." },
  { q: "Al colocar recipientes con comida caliente en un baño de hielo, ¿cuál es el nivel de profundidad de alimento permitido en la heladera para sopas o cremas?", o: ["No sobrepasar el nivel de 7 u 8 centímetros de profundidad", "Hasta 20 centímetros", "Llenar el recipiente hasta el borde"], a: "No sobrepasar el nivel de 7 u 8 centímetros de profundidad", r: "Página 46: Alimentos como sopas, cremas o similares no deben sobrepasar el nivel de 7 u 8 centímetros de profundidad." },
  { q: "En preparaciones de alimentos muy espesas que se van a enfriar en heladera, ¿qué profundidad máxima no deben superar?", o: ["6 centímetros de profundidad", "12 centímetros de profundidad", "2 centímetros de profundidad"], a: "6 centímetros de profundidad", r: "Página 46: Preparaciones muy espesas no deben sobrepasar el nivel de 6 centímetros." },
  { q: "Si las normas locales obligan a mantener los recipientes cubiertos durante el enfriamiento en heladera, ¿qué alternativa se sugiere si la norma lo permite?", o: ["Dejar destapado un tercio del recipiente para acelerar el proceso", "Perforar la base del recipiente", "Usar tapas de madera gruesa"], a: "Dejar destapado un tercio del recipiente para acelerar el proceso", r: "Página 46: Los recipientes cubiertos hacen que el enfriamiento sea más lento; podría dejarse destapado un tercio del recipiente." }
